<controls:BaseZoneWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.Zoning.UI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:style="clr-namespace:Content.Client._RF.Stylesheets"
    xmlns:controls1="clr-namespace:Content.Client._RF.UserInterface.Controls"
    xmlns:controls2="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client._RF.NPC.GOAP.UI"
    Title="{Loc 'base-zone-window-title'}" MinSize="450 550">
    <BoxContainer Orientation="Vertical">
        <BoxContainer SetHeight="30">
            <RichTextLabel Text="{Loc 'base-zone-window-name-label'}" VerticalAlignment="Center" Margin="5 0 6 0"/>
            <BoxContainer Name="NameBox" VerticalAlignment="Center">
                <RichTextLabel Name="NameLabel" VerticalAlignment="Center"/>
                <TextureButton Name="EditButton" SetSize="18 18" Margin="5 0"
                               ModulateSelfOverride="{x:Static style:StyleFortress.GoldFortress}"
                               TexturePath="/Textures/_RF/Interface/pencil-solid.svg.192dpi.png"/>
            </BoxContainer>
            <BoxContainer Name="NameEditBox" VerticalAlignment="Center" Visible="False">
                <LineEdit Name="NameEdit" SetWidth="200" Margin="5 0"/>
                <TextureButton Name="ApplyNameButton" SetSize="22 22"
                               ModulateSelfOverride="{x:Static style:StyleFortress.GoldFortress}"
                               TexturePath="/Textures/_RF/Interface/check-solid.svg.192dpi.png"/>
                <PanelContainer StyleClasses="LowDivider" Margin="3"/>
                <TextureButton Name="CancelNameButton" SetSize="18 18"
                               ModulateSelfOverride="{x:Static style:StyleFortress.GoldFortress}"
                               TexturePath="/Textures/_RF/Interface/Style/cross.png"/>
            </BoxContainer>
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" Margin="3 5"/>

        <ScrollContainer VerticalExpand="True">
            <BoxContainer Orientation="Vertical">
                <ui:ExpandableBox Name="ContentBox" Title="{Loc 'base-zone-window-content-title'}"
                                  Orientation="Vertical"/>

                <PanelContainer Name="ContentDivider" Margin="3 5" StyleClasses="LowDivider" Visible="False"/>

                <ui:ExpandableBox Name="VisualsExpand" Title="{Loc 'base-zone-window-visuals-title'}" Visible="False">
                    <BoxContainer Name="VisualsBox" Orientation="Vertical"/>
                    <BoxContainer Name="VisualChangesBox" Visible="False">
                        <PanelContainer StyleClasses="PanelDark" Margin="2 3">
                            <BoxContainer HorizontalExpand="True">
                                <Button Name="SaveVisualsButton" Text="{Loc 'base-zone-window-visuals-save-button'}"
                                        Margin="3 2" StyleClasses="OpenRight"/>
                                <Button Name="ResetVisualsButton" Text="{Loc 'base-zone-window-visuals-reset-button'}"
                                        Margin="3 2" StyleClasses="OpenLeft ButtonColorRed"/>
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                </ui:ExpandableBox>
            </BoxContainer>
        </ScrollContainer>

        <PanelContainer StyleClasses="AngleRect">
            <BoxContainer Margin="4 2">
                <Control HorizontalExpand="True"/>

                <controls1:IconButton Name="ExpandButton" SetSize="40 40" StyleClasses="ButtonSquare"
                                      ToolTip="{Loc 'base-zone-window-expand-button-tooltip'}" TextureScale="2 2"
                                      TexturePath="/Textures/_RF/Interface/expand-solid-full.svg.192dpi.png"/>

                <controls1:IconButton Name="ShrinkButton" SetSize="40 40" StyleClasses="ButtonSquare"
                                      ToolTip="{Loc 'base-zone-window-shrink-button-tooltip'}" TextureScale="2 2"
                                      TexturePath="/Textures/_RF/Interface/VerbIcons/eraser-solid.svg.192dpi.png"/>

                <controls2:ConfirmButton Name="DeleteButton" SetSize="40 40"
                                         StyleClasses="ButtonSquare" ConfirmationText=""
                                         ToolTip="{Loc 'base-zone-window-delete-button-tooltip'}">
                    <TextureRect Stretch="KeepAspectCentered" SetSize="24 24"
                                 ModulateSelfOverride="{x:Static style:StyleFortress.GoldFortress}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 TexturePath="/Textures/_RF/Interface/ban-solid-full.svg.192dpi.png"/>
                </controls2:ConfirmButton>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:BaseZoneWindow>

<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    SetSize="500 700" Margin="3 0"
    Title="{Loc 'rf-construction-menu-label'}">
    <BoxContainer Orientation="Vertical" Margin="3 0">
        <PanelContainer StyleClasses="PanelDarkBordered" Name="SearchBar" Visible="False">
            <BoxContainer Orientation="Horizontal">
                <PanelContainer StyleClasses="PanelLight" SetSize="32 32">
                    <TextureButton Name="BackButton" SetSize="32 32" StyleClasses="CrossButtonRed"
                                   TexturePath="/Textures/Interface/VerbIcons/close.svg.192dpi.png"/>
                </PanelContainer>
                <LineEdit Name="Search"
                          PlaceHolder="{Loc 'rf-construction-menu-search-placeholder'}"
                          VerticalExpand="True" HorizontalExpand="True"/>
            </BoxContainer>
        </PanelContainer>

        <PanelContainer StyleClasses="PanelLightBordered" VerticalExpand="True" HorizontalExpand="True">
            <ScrollContainer Name="MainScroll" VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="CategoryList" Access="Public"
                              VerticalExpand="True" HorizontalExpand="True"
                              Orientation="Vertical"/>
                <BoxContainer Name="ItemList" Access="Public"
                              VerticalExpand="True" HorizontalExpand="True"
                              Orientation="Vertical" Visible="False"/>
            </ScrollContainer>
        </PanelContainer>

        <PanelContainer Name="Metadata" Access="Public" SetHeight="250"
                        StyleClasses="PanelDarkBordered" Visible="False">
            <BoxContainer Orientation="Vertical">
                <BoxContainer Orientation="Horizontal" Margin="5 3 5 0">
                    <PanelContainer StyleClasses="PanelLight" SetSize="50 50">
                        <LayeredTextureRect Name="MetaTexture" Access="Public"
                                            SetSize="48 48" Stretch="KeepAspectCentered"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </PanelContainer>
                    <Label Name="MetaName" Access="Public" Margin="10 0 0 0"
                           Align="Left" StyleClasses="LabelBig"/>
                </BoxContainer>

                <PanelContainer StyleClasses="HighDivider" Margin="2 10"/>

                <RichTextLabel Name="MetaDescription" Access="Public"
                               HorizontalExpand="True"/>

                <PanelContainer StyleClasses="HighDivider" Margin="2 10"/>

                <ItemList Name="StepList" VerticalExpand="True"/>
            </BoxContainer>
        </PanelContainer>

        <BoxContainer>
            <Button Name="EraseButton" Access="Public"
                    Margin="3" StyleClasses="OpenBoth"
                    ToggleMode="True" Text="{Loc 'rf-construction-menu-erase'}"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>

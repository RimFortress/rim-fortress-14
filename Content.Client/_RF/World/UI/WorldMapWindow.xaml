<controls1:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.World.UI"
    xmlns:controls1="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:controls2="clr-namespace:Content.Client._RF.UserInterface.Controls"
    Title="{Loc 'world-map-user-interface-title'}"
    MinSize="1210 700">
    <BoxContainer Orientation="Vertical">
        <controls2:FancyBack Name="Header">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <controls2:IconButton Name="ResetCoordsButton" StyleClasses="ButtonSquare" SetSize="28 28"
                                      ToolTip="{Loc 'world-map-user-interface-reset-coords-tooltip'}"
                                      TexturePath="/Textures/Interface/VerbIcons/refresh.svg.192dpi.png"/>
                <Label Name="Coordinates" Align="Left" VAlign="Center" Margin="3 0"/>
                <BoxContainer HorizontalExpand="True"/>
                <controls2:ColorPicker Name="FactionColor"
                                       SetHeight="32" HorizontalAlignment="Right"/>
            </BoxContainer>
        </controls2:FancyBack>
        <controls:WorldMapControl Name="WorldMap" Access="Public"/>
    </BoxContainer>
</controls1:FancyWindow>

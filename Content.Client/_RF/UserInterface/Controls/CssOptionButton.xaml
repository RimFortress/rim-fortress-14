<controls:CssOptionButton
    xmlns="https://spacestation14.io"
    xmlns:css="clr-namespace:Content.Client._RF.CSS"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    ItemCssStyleClasses="open-both font-small option-button-item">
    <controls:CssBoxContainer FlexDirection="Row" MouseFilter="Ignore">
        <css:CssControl Name="LabelControl" MouseFilter="Ignore" FlexGrow="1"
                        AlignSelf="Center" CssStyleClasses="option-button"/>
        <css:CssControl Name="Triangle" MouseFilter="Ignore"
                        AlignSelf="Center" CssStyleClasses="option-triangle"/>
    </controls:CssBoxContainer>
</controls:CssOptionButton>

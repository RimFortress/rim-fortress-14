<controls:RfColorSelectorSliders
    xmlns="https://spacestation14.io"
    xmlns:suil="clr-namespace:Content.Client._RF.Suil"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    FlexDirection="Column">
    <!-- Styled by Resources/UI/_RF/input/color-selector.suil -->
    <controls:RfBoxContainer FlexDirection="Row" SuilStyleClasses="color-selector-header">
        <controls:RfOptionButton Name="TypeSelector" />
        <suil:UiElement Name="DescriptionLabel" FlexGrow="1" AlignSelf="Center" />
    </controls:RfBoxContainer>

    <controls:RfBoxContainer FlexDirection="Row" SuilStyleClasses="color-selector-row">
        <suil:UiElement Name="TopLabel" SuilStyleClasses="color-selector-label" />
        <controls:RfColorSlider Name="TopSlider" FlexGrow="1" AlignSelf="Center" />
        <controls:IntCounter Name="TopInput" />
    </controls:RfBoxContainer>

    <controls:RfBoxContainer FlexDirection="Row" SuilStyleClasses="color-selector-row">
        <suil:UiElement Name="MiddleLabel" SuilStyleClasses="color-selector-label" />
        <controls:RfColorSlider Name="MiddleSlider" FlexGrow="1" AlignSelf="Center" />
        <controls:IntCounter Name="MiddleInput" />
    </controls:RfBoxContainer>

    <controls:RfBoxContainer FlexDirection="Row" SuilStyleClasses="color-selector-row">
        <suil:UiElement Name="BottomLabel" SuilStyleClasses="color-selector-label" />
        <controls:RfColorSlider Name="BottomSlider" FlexGrow="1" AlignSelf="Center" />
        <controls:IntCounter Name="BottomInput" />
    </controls:RfBoxContainer>

    <controls:RfBoxContainer Name="AlphaRow" FlexDirection="Row" Visible="False"
                              SuilStyleClasses="color-selector-row">
        <suil:UiElement Name="AlphaLabel" SuilStyleClasses="color-selector-label"
                        Text="{Loc 'color-selector-sliders-alpha'}" />
        <controls:RfSlider Name="AlphaSlider" FlexGrow="1" AlignSelf="Center" MaxValue="1" />
        <controls:IntCounter Name="AlphaInput" />
    </controls:RfBoxContainer>

    <controls:RfBoxContainer FlexDirection="Row" SuilStyleClasses="color-selector-row">
        <suil:UiElement Name="HexLabel" SuilStyleClasses="color-selector-label"
                        Text="{Loc 'color-selector-input-hex'}" />
        <controls:RfLineEdit Name="HexEdit" FlexGrow="1" AlignSelf="Center" />
    </controls:RfBoxContainer>
</controls:RfColorSelectorSliders>

<controls:NpcJobsPopCell
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls.NpcJobs">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer StyleClasses="PanelHighlighted">
            <SpriteView Name="Icon" OverrideDirection="South"
                        SetSize="48 48" Stretch="Fill" Margin="2"/>
        </PanelContainer>
        <RichTextLabel Name="Name" Margin="5 0"
                       VerticalExpand="True" HorizontalExpand="True"/>
    </BoxContainer>
</controls:NpcJobsPopCell>

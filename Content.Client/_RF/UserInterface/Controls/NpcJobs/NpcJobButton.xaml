<controls:NpcJobButton
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls.NpcJobs"
    xmlns:controls1="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:controls2="clr-namespace:Content.Client._RF.UserInterface.Controls"
    xmlns:xNamespace="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:style="clr-namespace:Content.Client._RF.Stylesheets"
    StyleClasses="ButtonSquare" HorizontalExpand="True" ToggleMode="True">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
        <PanelContainer StyleClasses="PanelHighlighted">
            <controls:TextureSwitchButton Name="Icon" SetSize="24 24"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TexturesCollection="/Textures/_RF/Interface/VerbIcons/list-check-solid.svg.192dpi.png
                                                    /Textures/_RF/Interface/VerbIcons/skull-crossbones-solid.svg.192dpi.png
                                                    /Textures/_RF/Interface/VerbIcons/person-digging-solid.svg.192dpi.png
                                                    /Textures/_RF/Interface/VerbIcons/hand-holding-medical-solid.svg.192dpi.png
                                                    /Textures/_RF/Interface/VerbIcons/tree-solid.svg.192dpi.png
                                                    /Textures/_RF/Interface/cubes-solid.svg.192dpi.png
                                                    /Textures/_RF/Interface/VerbIcons/hand-solid.svg.192dpi.png
                                                    /Textures/_RF/Interface/VerbIcons/house-flag-solid-full.svg.192dpi.png
                                                    /Textures/_RF/Interface/VerbIcons/left-right-solid.svg.192dpi.png
                                                    /Textures/_RF/Interface/VerbIcons/hand-pointer-solid.svg.192dpi.png
                                                    /Textures/_RF/Interface/hammer-solid.svg.192dpi.png
                                                    /Textures/_RF/Interface/VerbIcons/trowel-bricks-solid.svg.192dpi.png
                                                    /Textures/_RF/Interface/VerbIcons/seedling-solid.svg.192dpi.png"/>
        </PanelContainer>

        <PanelContainer Margin="2 2" StyleClasses="LowDividerDark"/>

        <PanelContainer StyleClasses="PanelDarkBordered" Name="LabelContainer" HorizontalExpand="True">
            <Label Name="NameLabel" Align="Left" VAlign="Center"
                   HorizontalExpand="True" VerticalExpand="True"/>
        </PanelContainer>
        <LineEdit Name="NameEdit" HorizontalExpand="True" Visible="False"/>

        <controls2:IconButton Name="EditNameButton" StyleClasses="ButtonSquare" ReservesSpace="True"
                              TexturePath="/Textures/_RF/Interface/eye-dropper-solid.svg.192dpi.png"/>
        <controls1:ConfirmButton Name="DeleteButton" ConfirmationText="" StyleClasses="ButtonSquare">
            <TextureRect Stretch="KeepAspectCentered" SetSize="24 24"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TexturePath="/Textures/_RF/Interface/ban-solid-full.svg.192dpi.png"
                         ModulateSelfOverride="{xNamespace:Static style:StyleFortress.GoldFortress}"/>
        </controls1:ConfirmButton>
    </BoxContainer>
</controls:NpcJobButton>

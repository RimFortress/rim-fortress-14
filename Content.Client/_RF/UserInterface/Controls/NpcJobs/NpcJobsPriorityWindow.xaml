<controls:NpcJobsPriorityWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls.NpcJobs"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:table="clr-namespace:Content.Client._RF.UserInterface.Controls.Table"
    xmlns:controls1="clr-namespace:Content.Client._RF.UserInterface.Controls"
    MinSize="940 590" Title="{Loc 'npc-jobs-priority-window-title'}">
    <BoxContainer Orientation="Vertical">
        <table:TableControl Name="Table" HorizontalExpand="True" VerticalExpand="True"/>
        <controls1:FancyBack Margin="0 0 0 5">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Button Name="JobSettingsButton" Margin="3 0"
                        Text="{Loc 'npc-jobs-priority-window-settings-button-text'}"/>
            </BoxContainer>
        </controls1:FancyBack>
    </BoxContainer>
</controls:NpcJobsPriorityWindow>

<Button
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    Margin="2 0 2 5" MinHeight="50" ToggleMode="False"
    StyleClasses="ButtonSquare" HorizontalExpand="True"
    TrackingTooltip="True">
    <PanelContainer StyleClasses="PanelHighlighted">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <PanelContainer Margin="2" StyleClasses="LowDividerDark"/>

            <PanelContainer StyleClasses="PanelLightBordered" SetSize="52 52">
                <LayeredTextureRect Name="Texture" Access="Public"
                                    SetSize="48 48" Stretch="KeepAspectCentered"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </PanelContainer>

            <PanelContainer Margin="5 2" StyleClasses="HighDivider"/>

            <Label Name="Label" Align="Left" VAlign="Fill"
                   ClipText="True" HorizontalExpand="True"/>

            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right">
                <controls:IntCounter Name="Counter" Access="Public" MinValue="0"/>
                <CheckBox Name="UnlimitedCheck" Access="Public" Margin="3 0" TrackingTooltip="True"
                          ToolTip="{Loc 'stockpile-settings-menu-unlimited-checkbox-disabled-tooltip'}"/>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</Button>

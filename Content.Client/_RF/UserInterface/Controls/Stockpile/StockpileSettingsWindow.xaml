<controls1:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    xmlns:controls1="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:style="clr-namespace:Content.Client._RF.Stylesheets"
    SetSize="500 750">
    <BoxContainer Orientation="Vertical" VerticalExpand="True">
        <PanelContainer Name="AddressBox" StyleClasses="PanelLight" HorizontalExpand="True">
            <Label Name="Address" Margin="8 0 0 0" Align="Left"
                   VAlign="Center" StyleClasses="PlaceholderText"/>
        </PanelContainer>

        <PanelContainer Name="SearchBar" StyleClasses="PanelDark" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal">
                <TextureButton Name="BackButton" SetSize="32 32" StyleClasses="ButtonColorGold"
                               TexturePath="/Textures/Interface/VerbIcons/close.svg.192dpi.png"/>
                <LineEdit Name="Search" Margin="3 2" HorizontalExpand="True"
                          PlaceHolder="{Loc 'stockpile-settings-menu-search-placeholder'}"/>
            </BoxContainer>
        </PanelContainer>

        <BoxContainer VerticalExpand="True" HorizontalExpand="True">
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="ItemList" Orientation="Vertical"
                              VerticalExpand="True" HorizontalExpand="True"/>
            </ScrollContainer>
        </BoxContainer>

        <PanelContainer StyleClasses="HighDivider"/>

        <BoxContainer Orientation="Horizontal" Margin="3" SeparationOverride="5">
            <controls:IconButton Name="ExpandStockButton" SetSize="48 48"
                                 ToolTip="{Loc 'expand-stockpile-button-tooltip'}"
                                 TexturePath="/Textures/_RF/Interface/expand-solid-full.svg.192dpi.png"/>

            <controls:IconButton Name="ShrinkStockButton" SetSize="48 48"
                                 ToolTip="{Loc 'shrink-stockpile-button-tooltip'}"
                                 TexturePath="/Textures/_RF/Interface/VerbIcons/eraser-solid.svg.192dpi.png"/>

            <controls:IconButton Name="SuppliersButton" SetSize="48 48"
                                 ToolTip="{Loc 'stockpile-suppliers-button-tooltip'}"
                                 TexturePath="/Textures/_RF/Interface/right-to-bracket-solid-full.svg.192dpi.png"/>

            <controls1:ConfirmButton Name="DeleteStockButton" SetSize="48 48" ConfirmationText=""
                                     ToolTip="{Loc 'delete-stockpile-button-tooltip'}">
                <TextureRect Stretch="KeepAspectCentered"
                             SetSize="32 32" ModulateSelfOverride="{x:Static style:StyleFortress.GoldFortress}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             TexturePath="/Textures/_RF/Interface/ban-solid-full.svg.192dpi.png"/>
            </controls1:ConfirmButton>

            <BoxContainer HorizontalExpand="True"/>

            <controls:ColorPicker Name="ColorPicker" SetHeight="45" HorizontalAlignment="Center"/>
        </BoxContainer>
    </BoxContainer>
</controls1:FancyWindow>

<controls:StockpileMenu
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls.Stockpile"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:xNamespace="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    xmlns:controls1="clr-namespace:Content.Client._RF.UserInterface.Controls"
    HorizontalExpand="True">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="{xNamespace:Static style:StyleNano.PanelDark}"/>
        </PanelContainer.PanelOverride>
    </PanelContainer>
    <ScrollContainer MinWidth="90" HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Margin="5" Orientation="Vertical" VerticalExpand="True">
            <controls1:HotbarActionButton Name="CreateStockpileButton" Access="Public" IconModulate="#A16C2B"
                                         ToolTip="{Loc 'stockpile-menu-create-tooltip'}"
                                         IconTexturePath="/Textures/_RF/Interface/cubes-solid.svg.192dpi.png"/>
            <controls1:HotbarActionButton Name="EditStockpileButton" Access="Public" IconModulate="#BDB76B"
                                         ToolTip="{Loc 'stockpile-menu-edit-tooltip'}"
                                         IconTexturePath="/Textures/_RF/Interface/pencil-solid.svg.192dpi.png"/>
        </BoxContainer>
    </ScrollContainer>
</controls:StockpileMenu>

<controls:StockpileSettingsMenu
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls.Stockpile"
    xmlns:controls1="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    xmlns:ui="clr-namespace:Content.Client._RF.Lobby.UI"
    SetWidth="500" MinHeight="300" HorizontalExpand="True">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="{x:Static style:StyleNano.PanelDark}"/>
        </PanelContainer.PanelOverride>
    </PanelContainer>
    <BoxContainer Orientation="Vertical" VerticalExpand="True">
        <BoxContainer HorizontalExpand="True">
            <BoxContainer HorizontalExpand="True" Orientation="Horizontal">
                <ui:RfHighlightedContainer HorizontalExpand="True">
                    <Label Name="Label" Margin="8 0 0 0"
                           VAlign="Center" StyleClasses="FancyWindowTitle"/>
                    <BoxContainer HorizontalExpand="True"/>
                    <TextureButton Name="CloseButton" StyleClasses="windowCloseButton"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </ui:RfHighlightedContainer>
            </BoxContainer>
        </BoxContainer>
        <BoxContainer Name="SearchBar" HorizontalExpand="True">
            <ui:RfHighlightedContainer HorizontalExpand="True">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                    <TextureButton Name="BackButton" SetSize="32 32" StyleClasses="CrossButtonRed"
                                   TexturePath="/Textures/Interface/VerbIcons/close.svg.192dpi.png"/>
                    <LineEdit Name="Search"
                              PlaceHolder="{Loc 'stockpile-settings-menu-search-placeholder'}"
                              VerticalExpand="True" HorizontalExpand="True"/>
                </BoxContainer>
            </ui:RfHighlightedContainer>
        </BoxContainer>
        <BoxContainer Name="AddressBox" HorizontalExpand="True">
            <ui:RfHighlightedContainer HorizontalExpand="True">
                <Label Name="Address" Margin="8 0 0 0"
                       Align="Left" VAlign="Center"
                       StyleClasses="PlaceholderText"/>
            </ui:RfHighlightedContainer>
        </BoxContainer>
        <BoxContainer VerticalExpand="True" HorizontalExpand="True">
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="ItemList" Orientation="Vertical"
                              VerticalExpand="True" HorizontalExpand="True"/>
            </ScrollContainer>
        </BoxContainer>
        <BoxContainer HorizontalExpand="True">
            <ui:RfHighlightedContainer HorizontalExpand="True">
                <BoxContainer Orientation="Horizontal">
                    <Button Name="ExpandStockButton" SetSize="48 48"
                            Margin="0 0 3 0" ToolTip="{Loc 'expand-stockpile-button-tooltip'}">
                        <TextureRect Stretch="KeepAspectCentered" SetSize="32 32"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     TexturePath="/Textures/_RF/Interface/expand-solid-full.svg.192dpi.png"/>
                    </Button>
                    <Button Name="ShrinkStockButton" SetSize="48 48"
                            Margin="0 0 3 0" ToolTip="{Loc 'shrink-stockpile-button-tooltip'}">
                        <TextureRect Stretch="KeepAspectCentered" SetSize="32 32"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     TexturePath="/Textures/_RF/Interface/VerbIcons/eraser-solid.svg.192dpi.png"/>
                    </Button>
                    <controls1:ConfirmButton Name="DeleteStockButton" SetSize="48 48"
                                             Margin="0 0 3 0" ConfirmationText=""
                                             ToolTip="{Loc 'delete-stockpile-button-tooltip'}">
                        <TextureRect Stretch="KeepAspectCentered" SetSize="32 32"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     TexturePath="/Textures/_RF/Interface/ban-solid-full.svg.192dpi.png"/>
                    </controls1:ConfirmButton>
                    <BoxContainer HorizontalExpand="True"/>
                    <Button Name="SuppliersButton" SetSize="48 48" HorizontalAlignment="Right"
                            Margin="0 0 3 0" ToolTip="{Loc 'stockpile-suppliers-button-tooltip'}">
                        <TextureRect Stretch="KeepAspectCentered" SetSize="32 32"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     TexturePath="/Textures/_RF/Interface/right-to-bracket-solid-full.svg.192dpi.png"/>
                    </Button>
                </BoxContainer>
            </ui:RfHighlightedContainer>
        </BoxContainer>
    </BoxContainer>
</controls:StockpileSettingsMenu>

<controls:RfOptionButton
    xmlns="https://spacestation14.io"
    xmlns:suil="clr-namespace:Content.Client._RF.Suil"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    ItemSuilStyleClasses="open-both font-small option-button-item">
    <controls:RfBoxContainer FlexDirection="Row" MouseFilter="Ignore">
        <suil:UiElement Name="LabelControl" MouseFilter="Ignore" FlexGrow="1"
                        AlignSelf="Center" SuilStyleClasses="option-button"/>
        <suil:UiElement Name="Triangle" MouseFilter="Ignore"
                        AlignSelf="Center" SuilStyleClasses="option-triangle"/>
    </controls:RfBoxContainer>
</controls:RfOptionButton>

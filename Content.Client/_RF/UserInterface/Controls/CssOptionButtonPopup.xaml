<Popup
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls">
    <controls:CssScrollContainer Name="Scroll" Access="Public" ReturnMeasure="True" MaxHeight="300"
                                 CssStyleClasses="option-button-panel">
        <controls:CssBoxContainer FlexDirection="Column">
            <controls:CssLineEdit Name="FilterBox" Access="Public" Visible="False" SelectAllOnFocus="True"
                                  PlaceHolder="{Loc 'option-button-filter'}" />
            <controls:CssBoxContainer Name="ItemsBox" Access="Public" FlexDirection="Column" />
        </controls:CssBoxContainer>
    </controls:CssScrollContainer>
</Popup>

<controls:CssColorSelectorSliders
    xmlns="https://spacestation14.io"
    xmlns:css="clr-namespace:Content.Client._RF.CSS"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    FlexDirection="Column">
    <!-- Styled by Resources/CSS/_RF/input/color-selector.css -->
    <controls:CssBoxContainer FlexDirection="Row" CssStyleClasses="color-selector-header">
        <controls:CssOptionButton Name="TypeSelector" />
        <css:CssControl Name="DescriptionLabel" FlexGrow="1" AlignSelf="Center" />
    </controls:CssBoxContainer>

    <controls:CssBoxContainer FlexDirection="Row" CssStyleClasses="color-selector-row">
        <css:CssControl Name="TopLabel" CssStyleClasses="color-selector-label" />
        <controls:CssColorSlider Name="TopSlider" FlexGrow="1" AlignSelf="Center" />
        <controls:IntCounter Name="TopInput" />
    </controls:CssBoxContainer>

    <controls:CssBoxContainer FlexDirection="Row" CssStyleClasses="color-selector-row">
        <css:CssControl Name="MiddleLabel" CssStyleClasses="color-selector-label" />
        <controls:CssColorSlider Name="MiddleSlider" FlexGrow="1" AlignSelf="Center" />
        <controls:IntCounter Name="MiddleInput" />
    </controls:CssBoxContainer>

    <controls:CssBoxContainer FlexDirection="Row" CssStyleClasses="color-selector-row">
        <css:CssControl Name="BottomLabel" CssStyleClasses="color-selector-label" />
        <controls:CssColorSlider Name="BottomSlider" FlexGrow="1" AlignSelf="Center" />
        <controls:IntCounter Name="BottomInput" />
    </controls:CssBoxContainer>

    <controls:CssBoxContainer Name="AlphaRow" FlexDirection="Row" Visible="False"
                              CssStyleClasses="color-selector-row">
        <css:CssControl Name="AlphaLabel" CssStyleClasses="color-selector-label"
                        Text="{Loc 'color-selector-sliders-alpha'}" />
        <controls:CssSlider Name="AlphaSlider" FlexGrow="1" AlignSelf="Center" MaxValue="1" />
        <controls:IntCounter Name="AlphaInput" />
    </controls:CssBoxContainer>

    <controls:CssBoxContainer FlexDirection="Row" CssStyleClasses="color-selector-row">
        <css:CssControl Name="HexLabel" CssStyleClasses="color-selector-label"
                        Text="{Loc 'color-selector-input-hex'}" />
        <controls:CssLineEdit Name="HexEdit" FlexGrow="1" AlignSelf="Center" />
    </controls:CssBoxContainer>
</controls:CssColorSelectorSliders>

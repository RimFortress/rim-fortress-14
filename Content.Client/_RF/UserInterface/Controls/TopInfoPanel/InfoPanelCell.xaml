<controls:InfoPanelCell
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls.TopInfoPanel"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:style="clr-namespace:Content.Client._RF.Stylesheets"
    MouseFilter="Stop" TrackingTooltip="True" TooltipDelay="0" Margin="5 0">
    <BoxContainer>
        <TextureRect Name="Icon" SetSize="24 24" Stretch="KeepAspectCentered"
                     ModulateSelfOverride="{x:Static style:StyleFortress.RimSilver}"/>
        <PanelContainer StyleClasses="TopInfoCellPanel" Margin="5 0 0 0">
            <RichTextLabel Name="Label"/>
        </PanelContainer>
    </BoxContainer>
</controls:InfoPanelCell>

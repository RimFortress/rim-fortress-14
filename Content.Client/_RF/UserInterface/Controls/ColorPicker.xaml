<controls:ColorPicker
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls">
    <BoxContainer Orientation="Horizontal">
        <PanelContainer Name="ColorPanel" SetSize="30 30" Margin="4"
                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <controls:IconButton Name="PickColorButton" SetSize="32 32"
                             StyleClasses="ButtonSquare" ToolTip="{Loc 'color-picker-tooltip'}"
                             TexturePath="/Textures/_RF/Interface/eye-dropper-solid.svg.192dpi.png">
        </controls:IconButton>
    </BoxContainer>
</controls:ColorPicker>

<controls:ColorPicker
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls">
    <BoxContainer Orientation="Horizontal">
        <PanelContainer Name="ColorPanel" SetSize="32 32"
                        Margin="3" HorizontalAlignment="Right"/>
        <Button Name="PickColorButton" SetSize="32 32"
                StyleClasses="ButtonSquare" ToolTip="{Loc 'color-picker-tooltip'}">
            <TextureRect Name="ButtonTexture" Stretch="KeepAspectCentered"
                         ModulateSelfOverride="#7b7e9e"
                         HorizontalExpand="True" VerticalExpand="True"
                         TexturePath="/Textures/_RF/Interface/eye-dropper-solid.svg.192dpi.png"/>
        </Button>
    </BoxContainer>
</controls:ColorPicker>

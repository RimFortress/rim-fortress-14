<tooltip:TooltipPopup
    xmlns="https://spacestation14.io"
    xmlns:tooltip="clr-namespace:Content.Client._RF.UserInterface.Controls.Tooltip"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:style="clr-namespace:Content.Client._RF.Stylesheets"
    SetWidth="400" CloseOnClick="False" MouseOffset="10 10">
    <BoxContainer>
        <PanelContainer Name="Panel" StyleClasses="AngleRect">
            <BoxContainer Orientation="Vertical">
                <BoxContainer>
                    <PanelContainer Name="IconPanel" StyleClasses="PanelDark"
                                    SetSize="36 36" MouseFilter="Pass" Visible="False">
                        <BoxContainer HorizontalAlignment="Center" VerticalAlignment="Center">
                            <EntityPrototypeView Name="EntView" SetSize="32 32"/>
                            <TextureRect Name="Texture" SetSize="32 32"/>
                        </BoxContainer>
                    </PanelContainer>
                    <PanelContainer StyleClasses="LowDivider" Margin="5 3"/>
                    <Label Name="Title" HorizontalExpand="True" StyleClasses="LabelHeading"/>
                </BoxContainer>
                <PanelContainer StyleClasses="LowDivider"/>
                <RichTextLabel Name="Body" Margin="7 2 4 10"/>
                <controls:SimpleProgress Name="Progress" Margin="8 0 0 0" SetHeight="2"
                                         Color="{x:Static style:StyleFortress.GoldFortress}"/>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</tooltip:TooltipPopup>

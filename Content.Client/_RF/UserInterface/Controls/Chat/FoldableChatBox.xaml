<controls:FoldableChatBox
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls.Chat"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:style="clr-namespace:Content.Client._RF.Stylesheets"
    xmlns:controls1="clr-namespace:Content.Client._RF.UserInterface.Controls">
    <SplitContainer Orientation="Vertical" HorizontalExpand="True" ResizeMode="RespectChildrenMinSize">
        <BoxContainer Name="Container" MaxHeight="850" Orientation="Vertical">
            <PanelContainer StyleClasses="FoldableChatPanel">
                <BoxContainer>
                    <TextureRect Name="ChatIcon" SetSize="36 36" Margin="4" Stretch="KeepAspectCentered"
                                 ModulateSelfOverride="{x:Static style:StyleFortress.GoldFortress}"
                                 TexturePath="/Textures/_RF/Interface/comment-dots-regular.svg.192dpi.png"/>

                    <controls:ChatMessagesBubble Name="Bubble" HorizontalAlignment="Right" VerticalAlignment="Top"/>

                    <PanelContainer StyleClasses="LowDivider" Margin="5 3"/>
                    <controls1:FancyBack HorizontalExpand="True"/>

                    <controls1:IconButton Name="ToggleButton" SetSize="38 38"
                                          StyleClasses="ButtonSquare" ToolTip="{Loc 'foldable-chat-toggle-tooltip'}"
                                          TexturePath="/Textures/_RF/Interface/chevron-left-solid-full.svg.192dpi.png"/>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>

        <Control MinHeight="300"/>
    </SplitContainer>
</controls:FoldableChatBox>

<Control
    xmlns="https://spacestation14.io">
    <ScrollContainer>
        <BoxContainer Orientation="Vertical">
            <PanelContainer StyleClasses="PanelDarkBordered"
                            Margin="3 3 2 3" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical">
                    <GridContainer Columns="2">
                        <RichTextLabel Text="{Loc 'health-info-tab-status-label'}"/>
                        <RichTextLabel Name="StatusLabel"/>

                        <RichTextLabel Text="{Loc 'health-info-tab-temperature-label'}"/>
                        <RichTextLabel Name="TemperatureLabel"/>

                        <RichTextLabel Text="{Loc 'health-info-tab-blood-level-label'}"/>
                        <RichTextLabel Name="BloodLabel"/>

                        <RichTextLabel Text="{Loc 'health-info-tab-damage-total-label'}"/>
                        <RichTextLabel Name="DamageLabel"/>
                    </GridContainer>

                    <RichTextLabel Name="BleedingAlert" Margin="3 2"/>
                </BoxContainer>
            </PanelContainer>

            <GridContainer Name="GroupContainer" Margin="3 3 2 3" Columns="2"/>
        </BoxContainer>
    </ScrollContainer>
</Control>

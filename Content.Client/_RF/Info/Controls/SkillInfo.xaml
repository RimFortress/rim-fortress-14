<Control
    xmlns="https://spacestation14.io"
    Margin="2">
    <PanelContainer StyleClasses="PanelHighlighted">
        <BoxContainer Orientation="Vertical">
            <BoxContainer>
                <TextureRect Name="Icon" SetSize="14 14"
                             Stretch="KeepAspectCentered" Margin="3 2 1 0"/>
                <Label Name="Label" Margin="1"/>
                <BoxContainer HorizontalExpand="True"/>
                <Label Name="CurrentLevel" Margin="2 1"/>
            </BoxContainer>
            <ProgressBar Name="ProgressBar" SetHeight="30" HorizontalExpand="True">
                <BoxContainer Margin="2 3">
                    <Label Name="CurrentExp"/>
                    <BoxContainer HorizontalExpand="True"/>
                    <Label Name="MaxExp" Margin="3 0"/>
                </BoxContainer>
            </ProgressBar>
        </BoxContainer>
    </PanelContainer>
</Control>

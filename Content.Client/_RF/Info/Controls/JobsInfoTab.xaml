<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    xmlns:ui="clr-namespace:Content.Client._RF.Lobby.UI"
    xmlns:controls1="clr-namespace:Content.Client._RF.UserInterface.Controls">
    <ScrollContainer>
        <BoxContainer>
            <ui:RfHighlightedContainer>
                <BoxContainer Name="Container" Orientation="Vertical">

                </BoxContainer>
            </ui:RfHighlightedContainer>
            <controls1:VLine Thickness="2" Margin="2"
                             Color="{x:Static style:StyleNano.ButtonColorDisabled}"/>
            <ui:RfHighlightedContainer HorizontalExpand="True">
                <BoxContainer Orientation="Vertical">
                    <RichTextLabel Name="CurrentTask" MaxWidth="200"
                                   HorizontalAlignment="Left" Margin="2"/>
                    <BoxContainer VerticalExpand="True"/>
                    <Button Name="JobsSettingsButton" Margin="2"
                            Text="{Loc 'job-info-tab-jobs-settings'}"/>
                </BoxContainer>
            </ui:RfHighlightedContainer>
        </BoxContainer>
    </ScrollContainer>
</Control>

<Control
    xmlns="https://spacestation14.io">
    <ScrollContainer>
        <BoxContainer>
            <PanelContainer StyleClasses="PanelHighlighted">
                <BoxContainer Name="Container" Orientation="Vertical">

                </BoxContainer>
            </PanelContainer>

            <PanelContainer Margin="2" StyleClasses="LowDivider"/>

            <PanelContainer StyleClasses="PanelLightBordered" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical">
                    <RichTextLabel Name="CurrentTask" MaxWidth="200"
                                   HorizontalAlignment="Left" Margin="2"/>
                    <BoxContainer VerticalExpand="True"/>
                    <Button Name="JobsSettingsButton" Margin="2"
                            Text="{Loc 'job-info-tab-jobs-settings'}"/>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
    </ScrollContainer>
</Control>

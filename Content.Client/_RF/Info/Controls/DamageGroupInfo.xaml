<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Content.Client._RF.Lobby.UI"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    HorizontalExpand="True">
    <ui:RfHighlightedContainer>
        <BoxContainer Orientation="Vertical">
            <BoxContainer>
                <TextureRect Name="Icon" Margin="2 0" SetSize="30 30"
                             Stretch="KeepAspectCentered"/>
                <Label Name="Title" Margin="2 0"/>
            </BoxContainer>
            <controls:HLine Thickness="2" Margin="2 3"
                            Color="{x:Static style:StyleNano.NanoGold}"/>
            <BoxContainer Name="DamageTypes" Orientation="Vertical" Margin="3 0 0 0">

            </BoxContainer>
        </BoxContainer>
    </ui:RfHighlightedContainer>
</Control>

<ui:RfExpeditionEquipmentEditor
    xmlns="https://spacestation14.io"
    xmlns:css="clr-namespace:Content.Client._RF.CSS"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client._RF.Lobby.UI"
    FlexDirection="Column"
    CssStyleClasses="angle-rect-transparent">
    <!-- RimFortress: styled by Resources/CSS/_RF/lobby/ -->
    <!-- Top panel -->
    <controls:CssBoxContainer FlexDirection="Row" CssStyleClasses="fancy-back" CssStyleIdentifier="setup-header">
        <css:CssControl Text="{Loc 'expedition-equipment-editor-label'}"
                        CssStyleClasses="label-heading-bigger" CssStyleIdentifier="setup-title" />
        <css:CssControl CssStyleClasses="flex-fill" />
        <controls:CssButton Name="SaveButton" Access="Public"
                            Text="{Loc 'expedition-equipment-editor-save-button'}"
                            CssStyleClasses="font-big" />
        <controls:CssButton Name="ResetButton" Access="Public"
                            Text="{Loc 'expedition-equipment-editor-reset-button'}"
                            CssStyleClasses="font-big" />
        <controls:CssButton Name="CloseButton" Access="Public"
                            Text="{Loc 'expedition-equipment-editor-close-button'}"
                            CssStyleClasses="font-big" />
    </controls:CssBoxContainer>

    <controls:CssBoxContainer FlexDirection="Row" CssStyleIdentifier="equipment-body">
        <!-- Left panel -->
        <controls:CssBoxContainer FlexDirection="Column" CssStyleIdentifier="equipment-categories">
            <controls:CssBoxContainer FlexDirection="Row" CssStyleClasses="fancy-back" MinHeight="30">
                <css:CssControl Text="{Loc 'expedition-equipment-editor-categories'}"
                                CssStyleClasses="placeholder-text text-center" CssStyleIdentifier="equipment-categories-label" />
            </controls:CssBoxContainer>
            <controls:CssScrollContainer CssStyleClasses="scroll-vertical panel-light-transparent equipment-list"
                                         CssStyleIdentifier="equipment-categories-list">
                <controls:CssBoxContainer Name="CategoryBox" FlexDirection="Column" />
            </controls:CssScrollContainer>
        </controls:CssBoxContainer>

        <!-- Right panel -->
        <controls:CssBoxContainer FlexDirection="Column" CssStyleIdentifier="equipment-items">
            <controls:CssBoxContainer FlexDirection="Column" CssStyleClasses="panel-highlighted"
                                      CssStyleIdentifier="equipment-search-panel">
                <controls:CssBoxContainer FlexDirection="Row" CssStyleIdentifier="equipment-search-row">
                    <controls:CssLineEdit Name="Search" FlexGrow="1"
                                          PlaceHolder="{Loc 'expedition-equipment-editor-search'}" />
                    <controls:CssButton Name="ClearSearch" SetSize="36 36"
                                        CssStyleClasses="icon-button square">
                        <css:CssControl MouseFilter="Ignore" CssStyleClasses="icon icon-cross" />
                    </controls:CssButton>
                </controls:CssBoxContainer>

                <css:CssControl CssStyleClasses="low-divider" CssStyleIdentifier="equipment-search-divider" />

                <css:CssControl Name="PointsLabel" CssStyleIdentifier="equipment-points" />
            </controls:CssBoxContainer>
            <controls:CssScrollContainer CssStyleClasses="scroll-vertical panel-light-transparent equipment-list"
                                         CssStyleIdentifier="equipment-items-list">
                <controls:CssBoxContainer Name="ItemBox" FlexDirection="Column" />
            </controls:CssScrollContainer>
        </controls:CssBoxContainer>
    </controls:CssBoxContainer>
</ui:RfExpeditionEquipmentEditor>

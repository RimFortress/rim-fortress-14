<ui:RfExpeditionEquipmentEditor
    xmlns="https://spacestation14.io"
    xmlns:suil="clr-namespace:Content.Client._RF.Suil"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client._RF.Lobby.UI"
    FlexDirection="Column"
    SuilStyleClasses="angle-rect-transparent">
    <!-- RimFortress: styled by Resources/UI/_RF/lobby/ -->
    <!-- Top panel -->
    <controls:RfBoxContainer FlexDirection="Row" SuilStyleClasses="fancy-back" SuilStyleIdentifier="setup-header">
        <suil:UiElement Text="{Loc 'expedition-equipment-editor-label'}"
                        SuilStyleClasses="label-heading-bigger" SuilStyleIdentifier="setup-title" />
        <suil:UiElement SuilStyleClasses="flex-fill" />
        <controls:RfButton Name="SaveButton" Access="Public"
                            Text="{Loc 'expedition-equipment-editor-save-button'}"
                            SuilStyleClasses="font-big" />
        <controls:RfButton Name="ResetButton" Access="Public"
                            Text="{Loc 'expedition-equipment-editor-reset-button'}"
                            SuilStyleClasses="font-big" />
        <controls:RfButton Name="CloseButton" Access="Public"
                            Text="{Loc 'expedition-equipment-editor-close-button'}"
                            SuilStyleClasses="font-big" />
    </controls:RfBoxContainer>

    <controls:RfBoxContainer FlexDirection="Row" SuilStyleIdentifier="equipment-body">
        <!-- Left panel -->
        <controls:RfBoxContainer FlexDirection="Column" SuilStyleIdentifier="equipment-categories">
            <controls:RfBoxContainer FlexDirection="Row" SuilStyleClasses="fancy-back" MinHeight="30">
                <suil:UiElement Text="{Loc 'expedition-equipment-editor-categories'}"
                                SuilStyleClasses="placeholder-text text-center" SuilStyleIdentifier="equipment-categories-label" />
            </controls:RfBoxContainer>
            <controls:RfScrollContainer SuilStyleClasses="scroll-vertical panel-light-transparent equipment-list"
                                         SuilStyleIdentifier="equipment-categories-list">
                <controls:RfBoxContainer Name="CategoryBox" FlexDirection="Column" />
            </controls:RfScrollContainer>
        </controls:RfBoxContainer>

        <!-- Right panel -->
        <controls:RfBoxContainer FlexDirection="Column" SuilStyleIdentifier="equipment-items">
            <controls:RfBoxContainer FlexDirection="Column" SuilStyleClasses="panel-highlighted"
                                      SuilStyleIdentifier="equipment-search-panel">
                <controls:RfBoxContainer FlexDirection="Row" SuilStyleIdentifier="equipment-search-row">
                    <controls:RfLineEdit Name="Search" FlexGrow="1"
                                          PlaceHolder="{Loc 'expedition-equipment-editor-search'}" />
                    <controls:RfButton Name="ClearSearch" SetSize="36 36"
                                        SuilStyleClasses="icon-button square">
                        <suil:UiElement MouseFilter="Ignore" SuilStyleClasses="icon icon-cross" />
                    </controls:RfButton>
                </controls:RfBoxContainer>

                <suil:UiElement SuilStyleClasses="low-divider" SuilStyleIdentifier="equipment-search-divider" />

                <suil:UiElement Name="PointsLabel" SuilStyleIdentifier="equipment-points" />
            </controls:RfBoxContainer>
            <controls:RfScrollContainer SuilStyleClasses="scroll-vertical panel-light-transparent equipment-list"
                                         SuilStyleIdentifier="equipment-items-list">
                <controls:RfBoxContainer Name="ItemBox" FlexDirection="Column" />
            </controls:RfScrollContainer>
        </controls:RfBoxContainer>
    </controls:RfBoxContainer>
</ui:RfExpeditionEquipmentEditor>

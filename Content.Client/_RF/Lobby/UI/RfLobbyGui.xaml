<lobbyUi:RfLobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lobbyUi="clr-namespace:Content.Client._RF.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:rfInfo="clr-namespace:Content.Client._RF.Info.Controls"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets"
    xmlns:ui="clr-namespace:Content.Client.Lobby.UI"
    xmlns:css="clr-namespace:Content.Client._RF.CSS"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls">
    <!-- RimFortress: styled by Resources/CSS/_RF/lobby/ -->
    <!-- Background -->
    <TextureRect Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                 Stretch="KeepAspectCovered" />
    <controls:CssBoxContainer Name="MainContainer" FlexDirection="Row" CssStyleIdentifier="lobby-main">
        <!-- LHS Controls -->
        <controls:CssBoxContainer Name="LeftSide" FlexDirection="Column" CssStyleIdentifier="lobby-left">
            <controls:CssBoxContainer Name="DefaultState" FlexDirection="Column"
                                      CssStyleIdentifier="lobby-default-state">
                <controls:CssBoxContainer Name="TopLeft" FlexDirection="Column">
                    <!-- Left Top Panel -->
                    <controls:CssBoxContainer Name="LeftSideTop" FlexDirection="Column"
                                              CssStyleClasses="angle-rect"
                                              CssStyleIdentifier="lobby-left-top">
                        <rfInfo:RfLinkBanner Name="LinkBanner" AlignSelf="Center" Margin="3 3 3 3" />
                        <controls:CssBoxContainer FlexDirection="Row" CssStyleClasses="fancy-back"
                                                  CssStyleIdentifier="lobby-start-row">
                            <controls:CssUICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                                         Text="{Loc 'ui-lobby-observe-button'}"
                                                         CssStyleClasses="font-big"
                                                         WindowType="{x:Type ui:ObserveWarningWindow}" />
                            <css:CssControl Name="StartTime" Access="Public"
                                            CssStyleClasses="font-big text-center"
                                            CssStyleIdentifier="lobby-start-time" />
                            <controls:CssButton Name="ReadyButton" Access="Public" ToggleMode="True"
                                                Text="{Loc 'ui-lobby-ready-up-button'}"
                                                CssStyleClasses="font-big"
                                                CssStyleIdentifier="lobby-ready-button" />
                        </controls:CssBoxContainer>
                    </controls:CssBoxContainer>
                    <!-- Voting Popups -->
                    <controls:CssBoxContainer Name="VoteContainer" Access="Public" FlexDirection="Column"
                                              CssStyleIdentifier="lobby-votes" />
                </controls:CssBoxContainer>
                <!-- Left Bot Panel -->
                <controls:CssBoxContainer FlexDirection="Row" CssStyleIdentifier="lobby-left-bottom">
                    <rfInfo:RfDevInfoBanner Name="DevInfoBanner" Margin="3 3 3 3" />
                    <controls:CssBoxContainer FlexDirection="Row" CssStyleClasses="angle-rect"
                                              CssStyleIdentifier="lobby-credits">
                        <css:CssControl Name="LobbySong" Access="Public" />
                        <css:CssControl Name="LobbyBackground" Access="Public" />
                    </controls:CssBoxContainer>
                </controls:CssBoxContainer>
            </controls:CssBoxContainer>
            <!-- Character setup state -->
            <!-- This is injected on startup. Funky! -->
            <controls:CssBoxContainer Access="Public" Visible="False" Name="CharacterSetupState"
                                      FlexDirection="Column" CssStyleIdentifier="lobby-setup-state" />
            <!-- Equipment editor state -->
            <controls:CssBoxContainer Access="Public" Visible="False" Name="EquipmentEditorState"
                                      FlexDirection="Column" CssStyleIdentifier="lobby-setup-state" />
        </controls:CssBoxContainer>

        <!-- Right Panel -->
        <controls:CssBoxContainer Name="RightSide" Access="Public" FlexDirection="Column"
                                  CssStyleClasses="angle-rect-transparent"
                                  CssStyleIdentifier="lobby-right">
            <!-- Top row -->
            <controls:CssBoxContainer Name="HeaderContainer" Access="Public" FlexDirection="Row"
                                      CssStyleClasses="fancy-back" CssStyleIdentifier="lobby-header">
                <css:CssControl Name="ServerName" Access="Public" CssStyleClasses="label-heading-bigger" />
            </controls:CssBoxContainer>

            <css:CssControl CssStyleClasses="low-divider" CssStyleIdentifier="lobby-divider" />

            <controls:CssBoxContainer FlexDirection="Row" CssStyleIdentifier="lobby-info-row">
                <!-- Server info -->
                <controls:CssBoxContainer FlexDirection="Column" CssStyleClasses="panel-highlighted"
                                          CssStyleIdentifier="lobby-server-info">
                    <css:CssControl Text="{Loc 'ui-lobby-server-info-block'}"
                                    CssStyleClasses="rim-heading label-heading" />

                    <info:ServerInfo Name="ServerInfo" Access="Public" MaxWidth="400"
                                     Margin="3" HorizontalAlignment="Left" />

                    <css:CssControl Name="StationTime" Access="Public"
                                    CssStyleIdentifier="lobby-station-time" />
                </controls:CssBoxContainer>

                <css:CssControl CssStyleClasses="high-divider" />

                <!-- Voting & misc buttons -->
                <controls:CssBoxContainer FlexDirection="Column" CssStyleClasses="panel-highlighted"
                                          CssStyleIdentifier="lobby-actions">
                    <controls:CssButton Name="AHelpButton" Access="Public" Text="{Loc 'ui-lobby-ahelp-button'}"
                                        CssStyleClasses="font-big" />
                    <controls:CssVoteCallMenuButton Name="CallVoteButton" CssStyleClasses="font-big" />

                    <css:CssControl CssStyleClasses="flex-fill" />

                    <controls:CssButton Name="OptionsButton" Access="Public" CssStyleClasses="font-big"
                                        Text="{Loc 'ui-lobby-options-button'}" />
                    <controls:CssButton Name="LeaveButton" Access="Public" CssStyleClasses="font-big"
                                        Text="{Loc 'ui-lobby-leave-button'}" />
                </controls:CssBoxContainer>
            </controls:CssBoxContainer>

            <lobbyUi:RfLobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" Margin="10" />

            <css:CssControl CssStyleClasses="low-divider" CssStyleIdentifier="lobby-divider" />

            <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True" Margin="3 3 3 3" MinHeight="50" />
        </controls:CssBoxContainer>
    </controls:CssBoxContainer>
</lobbyUi:RfLobbyGui>

<lobbyUi:RfLobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lobbyUi="clr-namespace:Content.Client._RF.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:rfInfo="clr-namespace:Content.Client._RF.Info.Controls"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets"
    xmlns:ui="clr-namespace:Content.Client.Lobby.UI"
    xmlns:suil="clr-namespace:Content.Client._RF.Suil"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls">
    <!-- RimFortress: styled by Resources/UI/_RF/lobby/ -->
    <!-- Background -->
    <TextureRect Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                 Stretch="KeepAspectCovered" />
    <controls:RfBoxContainer Name="MainContainer" FlexDirection="Row" SuilStyleIdentifier="lobby-main">
        <!-- LHS Controls -->
        <controls:RfBoxContainer Name="LeftSide" FlexDirection="Column" SuilStyleIdentifier="lobby-left">
            <controls:RfBoxContainer Name="DefaultState" FlexDirection="Column"
                                      SuilStyleIdentifier="lobby-default-state">
                <controls:RfBoxContainer Name="TopLeft" FlexDirection="Column">
                    <!-- Left Top Panel -->
                    <controls:RfBoxContainer Name="LeftSideTop" FlexDirection="Column"
                                              SuilStyleClasses="angle-rect"
                                              SuilStyleIdentifier="lobby-left-top">
                        <rfInfo:RfLinkBanner Name="LinkBanner" AlignSelf="Center" Margin="3 3 3 3" />
                        <controls:RfBoxContainer FlexDirection="Row" SuilStyleClasses="fancy-back"
                                                  SuilStyleIdentifier="lobby-start-row">
                            <controls:RfUICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                                         Text="{Loc 'ui-lobby-observe-button'}"
                                                         SuilStyleClasses="font-big"
                                                         WindowType="{x:Type ui:ObserveWarningWindow}" />
                            <suil:UiElement Name="StartTime" Access="Public"
                                            SuilStyleClasses="font-big text-center"
                                            SuilStyleIdentifier="lobby-start-time" />
                            <controls:RfButton Name="ReadyButton" Access="Public" ToggleMode="True"
                                                Text="{Loc 'ui-lobby-ready-up-button'}"
                                                SuilStyleClasses="font-big"
                                                SuilStyleIdentifier="lobby-ready-button" />
                        </controls:RfBoxContainer>
                    </controls:RfBoxContainer>
                    <!-- Voting Popups -->
                    <controls:RfBoxContainer Name="VoteContainer" Access="Public" FlexDirection="Column"
                                              SuilStyleIdentifier="lobby-votes" />
                </controls:RfBoxContainer>
                <!-- Left Bot Panel -->
                <controls:RfBoxContainer FlexDirection="Row" SuilStyleIdentifier="lobby-left-bottom">
                    <rfInfo:RfDevInfoBanner Name="DevInfoBanner" Margin="3 3 3 3" />
                    <controls:RfBoxContainer FlexDirection="Row" SuilStyleClasses="angle-rect"
                                              SuilStyleIdentifier="lobby-credits">
                        <suil:UiElement Name="LobbySong" Access="Public" />
                        <suil:UiElement Name="LobbyBackground" Access="Public" />
                    </controls:RfBoxContainer>
                </controls:RfBoxContainer>
            </controls:RfBoxContainer>
            <!-- Character setup state -->
            <!-- This is injected on startup. Funky! -->
            <controls:RfBoxContainer Access="Public" Visible="False" Name="CharacterSetupState"
                                      FlexDirection="Column" SuilStyleIdentifier="lobby-setup-state" />
            <!-- Equipment editor state -->
            <controls:RfBoxContainer Access="Public" Visible="False" Name="EquipmentEditorState"
                                      FlexDirection="Column" SuilStyleIdentifier="lobby-setup-state" />
        </controls:RfBoxContainer>

        <!-- Right Panel -->
        <controls:RfBoxContainer Name="RightSide" Access="Public" FlexDirection="Column"
                                  SuilStyleClasses="angle-rect-transparent"
                                  SuilStyleIdentifier="lobby-right">
            <!-- Top row -->
            <controls:RfBoxContainer Name="HeaderContainer" Access="Public" FlexDirection="Row"
                                      SuilStyleClasses="fancy-back" SuilStyleIdentifier="lobby-header">
                <suil:UiElement Name="ServerName" Access="Public" SuilStyleClasses="label-heading-bigger" />
            </controls:RfBoxContainer>

            <suil:UiElement SuilStyleClasses="low-divider" SuilStyleIdentifier="lobby-divider" />

            <controls:RfBoxContainer FlexDirection="Row" SuilStyleIdentifier="lobby-info-row">
                <!-- Server info -->
                <controls:RfBoxContainer FlexDirection="Column" SuilStyleClasses="panel-highlighted"
                                          SuilStyleIdentifier="lobby-server-info">
                    <suil:UiElement Text="{Loc 'ui-lobby-server-info-block'}"
                                    SuilStyleClasses="rim-heading label-heading" />

                    <info:ServerInfo Name="ServerInfo" Access="Public" MaxWidth="400"
                                     Margin="3" HorizontalAlignment="Left" />

                    <suil:UiElement Name="StationTime" Access="Public"
                                    SuilStyleIdentifier="lobby-station-time" />
                </controls:RfBoxContainer>

                <suil:UiElement SuilStyleClasses="high-divider" />

                <!-- Voting & misc buttons -->
                <controls:RfBoxContainer FlexDirection="Column" SuilStyleClasses="panel-highlighted"
                                          SuilStyleIdentifier="lobby-actions">
                    <controls:RfButton Name="AHelpButton" Access="Public" Text="{Loc 'ui-lobby-ahelp-button'}"
                                        SuilStyleClasses="font-big" />
                    <controls:RfVoteCallMenuButton Name="CallVoteButton" SuilStyleClasses="font-big" />

                    <suil:UiElement SuilStyleClasses="flex-fill" />

                    <controls:RfButton Name="OptionsButton" Access="Public" SuilStyleClasses="font-big"
                                        Text="{Loc 'ui-lobby-options-button'}" />
                    <controls:RfButton Name="LeaveButton" Access="Public" SuilStyleClasses="font-big"
                                        Text="{Loc 'ui-lobby-leave-button'}" />
                </controls:RfBoxContainer>
            </controls:RfBoxContainer>

            <lobbyUi:RfLobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" Margin="10" />

            <suil:UiElement SuilStyleClasses="low-divider" SuilStyleIdentifier="lobby-divider" />

            <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True" Margin="3 3 3 3" MinHeight="50" />
        </controls:RfBoxContainer>
    </controls:RfBoxContainer>
</lobbyUi:RfLobbyGui>

<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
               Title="{Loc 'character-setup-gui-save-panel-title'}"
               Resizable="False">
    <!-- The window itself has no SUIL version yet, the content is styled by Resources/UI/_RF/lobby/ -->
    <controls:RfBoxContainer FlexDirection="Row" MinSize="200 40" SuilStyleIdentifier="save-panel">
        <controls:RfButton Name="SaveButton" Access="Public" Text="{Loc 'character-setup-gui-save-panel-save'}"
                            SuilStyleClasses="font-big" />
        <controls:RfButton Name="NoSaveButton" Access="Public" Text="{Loc 'character-setup-gui-save-panel-nosave'}"
                            SuilStyleClasses="font-big" />
        <controls:RfButton Name="CancelButton" Access="Public" Text="{Loc 'character-setup-gui-save-panel-cancel'}"
                            SuilStyleClasses="font-big" />
    </controls:RfBoxContainer>
</DefaultWindow>

<ui:CharacterSkillsTab
    xmlns="https://spacestation14.io"
    xmlns:css="clr-namespace:Content.Client._RF.CSS"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client._RF.Lobby.UI"
    FlexDirection="Column">
    <controls:CssScrollContainer CssStyleClasses="scroll-vertical" CssStyleIdentifier="skills-scroll">
        <controls:CssBoxContainer FlexDirection="Column">
            <controls:CssBoxContainer FlexDirection="Row" CssStyleIdentifier="skills-header">
                <css:CssControl Name="LeftLevels" CssStyleIdentifier="skills-left-levels" />
                <css:CssControl Name="LeftPoints" />
            </controls:CssBoxContainer>

            <css:CssControl CssStyleClasses="low-divider-dark" CssStyleIdentifier="skills-divider" />

            <controls:CssBoxContainer Name="Container" FlexDirection="Column" />
        </controls:CssBoxContainer>
    </controls:CssScrollContainer>
</ui:CharacterSkillsTab>

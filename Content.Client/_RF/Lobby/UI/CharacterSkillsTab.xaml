<ui:CharacterSkillsTab
    xmlns="https://spacestation14.io"
    xmlns:suil="clr-namespace:Content.Client._RF.Suil"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client._RF.Lobby.UI"
    FlexDirection="Column">
    <controls:RfScrollContainer SuilStyleClasses="scroll-vertical" SuilStyleIdentifier="skills-scroll">
        <controls:RfBoxContainer FlexDirection="Column">
            <controls:RfBoxContainer FlexDirection="Row" SuilStyleIdentifier="skills-header">
                <suil:UiElement Name="LeftLevels" SuilStyleIdentifier="skills-left-levels" />
                <suil:UiElement Name="LeftPoints" />
            </controls:RfBoxContainer>

            <suil:UiElement SuilStyleClasses="low-divider-dark" SuilStyleIdentifier="skills-divider" />

            <controls:RfBoxContainer Name="Container" FlexDirection="Column" />
        </controls:RfBoxContainer>
    </controls:RfScrollContainer>
</ui:CharacterSkillsTab>

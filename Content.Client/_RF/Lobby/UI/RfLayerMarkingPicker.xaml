<controls:RfBoxContainer
    xmlns="https://spacestation14.io"
    xmlns:suil="clr-namespace:Content.Client._RF.Suil"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    FlexDirection="Column">
    <controls:RfLineEdit Name="SearchBar" PlaceHolder="{Loc 'markings-search'}" />
    <controls:RfScrollContainer Name="SelectionItems" SuilStyleClasses="scroll-vertical">
        <controls:RfGridContainer Name="Items" Columns="2" SuilStyleClasses="marking-items" />
    </controls:RfScrollContainer>
    <controls:RfScrollContainer Name="OrderingItems" Visible="False" SuilStyleClasses="scroll-vertical" />
    <controls:RfBoxContainer FlexDirection="Row" SuilStyleClasses="marking-status-row">
        <suil:UiElement Name="MarkingsStatus" FlexGrow="1" AlignSelf="Center" />
        <controls:RfButton Name="ReorderButton" ToggleMode="True" Text="{Loc 'markings-reorder'}" />
    </controls:RfBoxContainer>
</controls:RfBoxContainer>

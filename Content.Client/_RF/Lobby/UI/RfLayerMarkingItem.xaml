<controls:RfBoxContainer
    xmlns="https://spacestation14.io"
    xmlns:suil="clr-namespace:Content.Client._RF.Suil"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    FlexDirection="Column" MouseFilter="Pass">
    <controls:RfBoxContainer FlexDirection="Row" SuilStyleClasses="marking-item-row">
        <controls:RfLayeredTexture Name="MarkingTexture" SetSize="64 64" MouseFilter="Ignore" AlignSelf="Center"
                                    SuilStyleClasses="panel-dark-bordered marking-preview" />

        <controls:RfButton Name="SelectButton" ToggleMode="True" FlexGrow="1" />

        <controls:RfButton Name="ColorsButton" ToggleMode="True" Visible="False" SetSize="36 36"
                            SuilStyleClasses="icon-button square">
            <suil:UiElement MouseFilter="Ignore" SuilStyleClasses="icon icon-palette" />
        </controls:RfButton>
    </controls:RfBoxContainer>

    <controls:RfBoxContainer Name="ColorsContainer" Visible="False" FlexDirection="Column"
                              SuilStyleClasses="marking-colors" />
</controls:RfBoxContainer>

<controls:CssBoxContainer
    xmlns="https://spacestation14.io"
    xmlns:css="clr-namespace:Content.Client._RF.CSS"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    FlexDirection="Row"
    CssStyleClasses="panel-dark-bordered">
    <controls:CssBoxContainer FlexDirection="Row" CssStyleClasses="panel-light-bordered">
        <EntityPrototypeView Name="View" Scale="2 2" SetSize="36 36" />
    </controls:CssBoxContainer>

    <css:CssControl CssStyleClasses="low-divider" CssStyleIdentifier="expedition-item-divider" />

    <css:CssControl Name="NameLabel" MouseFilter="Pass"
                    CssStyleClasses="placeholder-text" CssStyleIdentifier="expedition-item-name" />
    <css:CssControl Name="CostLabel"
                    CssStyleClasses="placeholder-text" CssStyleIdentifier="expedition-item-cost" />

    <css:CssControl CssStyleClasses="low-divider" CssStyleIdentifier="expedition-item-divider" />
    <controls:IntCounter Name="Counter" Access="Public" MinValue="0" />
</controls:CssBoxContainer>

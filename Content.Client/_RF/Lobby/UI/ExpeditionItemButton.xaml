<Control
    xmlns="https://spacestation14.io"
    Margin="0 0 0 3" HorizontalExpand="True">
    <PanelContainer StyleClasses="PanelDarkBordered">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <PanelContainer StyleClasses="PanelLightBordered">
                <EntityPrototypeView Name="View" Scale="2 2" SetSize="36 36"/>
            </PanelContainer>

            <PanelContainer Margin="10 5" StyleClasses="LowDivider"/>

            <TextureButton Name="Button" TrackingTooltip="True"
                           HorizontalExpand="True" VerticalExpand="True">
                <Label Name="NameLabel" Access="Public"
                       Align="Left" ClipText="True" VAlign="Bottom"
                       StyleClasses="PlaceholderText" FontColorOverride="#FFFFFFFF"/>
            </TextureButton>
            <Label Name="CostLabel" Align="Left"
                   VAlign="Bottom" VerticalExpand="True" SetWidth="150"
                   StyleClasses="PlaceholderText" FontColorOverride="#FFFFFFFF"/>

            <PanelContainer Margin="10 5" StyleClasses="LowDivider"/>

            <Button Name="Plus" Access="Public" Margin="2"
                    Text="+" StyleClasses="OpenRight"/>
            <LineEdit Name="CountLine" Text="0" Margin="0 3" MinWidth="50"/>
            <Button Name="Minus" Margin="2"
                    Text="–" StyleClasses="OpenLeft"/>
        </BoxContainer>
    </PanelContainer>
</Control>

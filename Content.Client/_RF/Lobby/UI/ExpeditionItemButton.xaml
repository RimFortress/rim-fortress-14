<controls:RfBoxContainer
    xmlns="https://spacestation14.io"
    xmlns:suil="clr-namespace:Content.Client._RF.Suil"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    FlexDirection="Row"
    SuilStyleClasses="panel-dark-bordered">
    <controls:RfBoxContainer FlexDirection="Row" SuilStyleClasses="panel-light-bordered">
        <EntityPrototypeView Name="View" Scale="2 2" SetSize="36 36" />
    </controls:RfBoxContainer>

    <suil:UiElement SuilStyleClasses="low-divider" SuilStyleIdentifier="expedition-item-divider" />

    <suil:UiElement Name="NameLabel" MouseFilter="Pass"
                    SuilStyleClasses="placeholder-text" SuilStyleIdentifier="expedition-item-name" />
    <suil:UiElement Name="CostLabel"
                    SuilStyleClasses="placeholder-text" SuilStyleIdentifier="expedition-item-cost" />

    <suil:UiElement SuilStyleClasses="low-divider" SuilStyleIdentifier="expedition-item-divider" />
    <controls:IntCounter Name="Counter" Access="Public" MinValue="0" />
</controls:RfBoxContainer>

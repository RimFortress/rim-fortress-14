<controls:CssBoxContainer
    xmlns="https://spacestation14.io"
    xmlns:css="clr-namespace:Content.Client._RF.CSS"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    FlexDirection="Column"
    CssStyleClasses="angle-rect-transparent">
    <!-- RimFortress: styled by Resources/CSS/_RF/lobby/ -->
    <controls:CssBoxContainer FlexDirection="Row" CssStyleClasses="fancy-back" CssStyleIdentifier="setup-header">
        <css:CssControl Text="{Loc 'character-setup-gui-character-setup-label'}"
                        CssStyleClasses="label-heading-bigger" CssStyleIdentifier="setup-title" />
        <css:CssControl CssStyleClasses="flex-fill" />
        <controls:CssButton Name="ResetButton" Access="Public"
                            Text="{Loc 'humanoid-profile-editor-reset-button'}"
                            CssStyleClasses="font-big" />
        <controls:CssButton Name="SaveProfilesButton" Access="Public"
                            Text="{Loc 'character-setup-gui-character-setup-save-profiles-button'}"
                            CssStyleClasses="font-big" />
        <controls:CssButton Name="StatsButton"
                            Text="{Loc 'character-setup-gui-character-setup-stats-button'}"
                            CssStyleClasses="font-big" />
        <controls:CssCommandButton Name="AdminRemarksButton"
                                   Command="adminremarks"
                                   Text="{Loc 'character-setup-gui-character-setup-adminremarks-button'}"
                                   CssStyleClasses="font-big" />
        <controls:CssButton Name="RulesButton"
                            Text="{Loc 'character-setup-gui-character-setup-rules-button'}"
                            CssStyleClasses="font-big" />
        <controls:CssButton Name="CloseButton" Access="Public"
                            Text="{Loc 'character-setup-gui-character-setup-close-button'}"
                            CssStyleClasses="font-big" />
    </controls:CssBoxContainer>

    <css:CssControl CssStyleClasses="low-divider" />

    <controls:CssBoxContainer FlexDirection="Row" CssStyleIdentifier="setup-body">
        <controls:CssBoxContainer FlexDirection="Column" CssStyleIdentifier="setup-characters">
            <controls:CssBoxContainer FlexDirection="Row" CssStyleClasses="fancy-back">
                <css:CssControl Name="CharactersCount" CssStyleIdentifier="setup-characters-count" />
            </controls:CssBoxContainer>
            <controls:CssScrollContainer CssStyleClasses="scroll-vertical" CssStyleIdentifier="setup-characters-scroll">
                <controls:CssBoxContainer Name="Characters" FlexDirection="Column" />
            </controls:CssScrollContainer>
        </controls:CssBoxContainer>

        <css:CssControl CssStyleClasses="low-divider" />

        <controls:CssBoxContainer Name="CharEditor" FlexDirection="Row" CssStyleIdentifier="setup-editor" />
    </controls:CssBoxContainer>
</controls:CssBoxContainer>

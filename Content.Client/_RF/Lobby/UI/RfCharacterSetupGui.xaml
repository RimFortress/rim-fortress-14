<controls:RfBoxContainer
    xmlns="https://spacestation14.io"
    xmlns:suil="clr-namespace:Content.Client._RF.Suil"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    FlexDirection="Column"
    SuilStyleClasses="angle-rect-transparent">
    <!-- RimFortress: styled by Resources/UI/_RF/lobby/ -->
    <controls:RfBoxContainer FlexDirection="Row" SuilStyleClasses="fancy-back" SuilStyleIdentifier="setup-header">
        <suil:UiElement Text="{Loc 'character-setup-gui-character-setup-label'}"
                        SuilStyleClasses="label-heading-bigger" SuilStyleIdentifier="setup-title" />
        <suil:UiElement SuilStyleClasses="flex-fill" />
        <controls:RfButton Name="ResetButton" Access="Public"
                            Text="{Loc 'humanoid-profile-editor-reset-button'}"
                            SuilStyleClasses="font-big" />
        <controls:RfButton Name="SaveProfilesButton" Access="Public"
                            Text="{Loc 'character-setup-gui-character-setup-save-profiles-button'}"
                            SuilStyleClasses="font-big" />
        <controls:RfButton Name="StatsButton"
                            Text="{Loc 'character-setup-gui-character-setup-stats-button'}"
                            SuilStyleClasses="font-big" />
        <controls:RfCommandButton Name="AdminRemarksButton"
                                   Command="adminremarks"
                                   Text="{Loc 'character-setup-gui-character-setup-adminremarks-button'}"
                                   SuilStyleClasses="font-big" />
        <controls:RfButton Name="RulesButton"
                            Text="{Loc 'character-setup-gui-character-setup-rules-button'}"
                            SuilStyleClasses="font-big" />
        <controls:RfButton Name="CloseButton" Access="Public"
                            Text="{Loc 'character-setup-gui-character-setup-close-button'}"
                            SuilStyleClasses="font-big" />
    </controls:RfBoxContainer>

    <suil:UiElement SuilStyleClasses="low-divider" />

    <controls:RfBoxContainer FlexDirection="Row" SuilStyleIdentifier="setup-body">
        <controls:RfBoxContainer FlexDirection="Column" SuilStyleIdentifier="setup-characters">
            <controls:RfBoxContainer FlexDirection="Row" SuilStyleClasses="fancy-back" MinHeight="30">
                <suil:UiElement Name="CharactersCount" SuilStyleClasses="text-center"/>
            </controls:RfBoxContainer>
            <controls:RfScrollContainer SuilStyleClasses="scroll-vertical" SuilStyleIdentifier="setup-characters-scroll">
                <controls:RfBoxContainer Name="Characters" FlexDirection="Column" />
            </controls:RfScrollContainer>
        </controls:RfBoxContainer>

        <suil:UiElement SuilStyleClasses="low-divider" />

        <controls:RfBoxContainer Name="CharEditor" FlexDirection="Row" SuilStyleIdentifier="setup-editor" />
    </controls:RfBoxContainer>
</controls:RfBoxContainer>

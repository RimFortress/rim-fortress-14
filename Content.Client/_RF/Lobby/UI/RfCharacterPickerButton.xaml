<controls:RfButton
    xmlns="https://spacestation14.io"
    xmlns:suil="clr-namespace:Content.Client._RF.Suil"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls">
    <controls:RfBoxContainer FlexDirection="Row" MouseFilter="Ignore" SuilStyleIdentifier="picker-row">
        <controls:RfBoxContainer FlexDirection="Column" MouseFilter="Ignore">
            <controls:RfButton Name="Up" Access="Public" Disabled="True" SetSize="36 36"
                                SuilStyleClasses="icon-button open-both">
                <suil:UiElement MouseFilter="Ignore" SuilStyleClasses="icon icon-sort-up" />
            </controls:RfButton>
            <suil:UiElement SuilStyleClasses="flex-fill" />
            <controls:RfButton Name="Down" Access="Public" Disabled="True" SetSize="36 36"
                                SuilStyleClasses="icon-button open-both">
                <suil:UiElement MouseFilter="Ignore" SuilStyleClasses="icon icon-sort-down" />
            </controls:RfButton>
        </controls:RfBoxContainer>
        <SpriteView Scale="2 2" Margin="0 4 4 4"
                    Name="View" SetSize="64 64"
                    OverrideDirection="South" />
        <suil:UiElement Name="DescriptionLabel"
                        MouseFilter="Ignore"
                        SuilStyleClasses="text-center"
                        SuilStyleIdentifier="picker-description" />
        <controls:RfConfirmButton Name="DeleteButton" SuilStyleClasses="open-both"
                                   Text="{Loc 'character-setup-gui-character-picker-button-delete-button'}"
                                   ConfirmationText="{Loc 'character-setup-gui-character-picker-button-confirm-delete-button'}" />
    </controls:RfBoxContainer>
</controls:RfButton>

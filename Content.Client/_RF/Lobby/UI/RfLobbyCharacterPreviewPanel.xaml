<ui:RfLobbyCharacterPreviewPanel
    xmlns="https://spacestation14.io"
    xmlns:suil="clr-namespace:Content.Client._RF.Suil"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client._RF.Lobby.UI"
    FlexDirection="Column">
    <suil:UiElement Text="{Loc 'lobby-characters-preview-panel-header'}"
                    SuilStyleClasses="rim-heading label-heading" />
    <controls:RfBoxContainer Name="Loaded" FlexDirection="Column" Visible="False">
        <controls:RfBoxContainer Name="ViewBox" FlexDirection="Row" SuilStyleIdentifier="preview-view-box" />
        <controls:RfBoxContainer FlexDirection="Row" SuilStyleIdentifier="preview-buttons">
            <controls:RfButton Name="CharacterSetup"
                                Text="{Loc 'lobby-character-preview-panel-characters-setup-button'}"
                                SuilStyleClasses="open-right" />
            <controls:RfButton Name="EquipmentSetup"
                                Text="{Loc 'lobby-character-preview-panel-equipment-setup-button'}"
                                SuilStyleClasses="open-left" />
        </controls:RfBoxContainer>
    </controls:RfBoxContainer>
    <suil:UiElement Name="Unloaded" Text="{Loc 'lobby-character-preview-panel-unloaded-preferences-label'}" />
</ui:RfLobbyCharacterPreviewPanel>

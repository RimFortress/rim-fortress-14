<ui:RfLobbyCharacterPreviewPanel
    xmlns="https://spacestation14.io"
    xmlns:css="clr-namespace:Content.Client._RF.CSS"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client._RF.Lobby.UI"
    FlexDirection="Column">
    <css:CssControl Text="{Loc 'lobby-characters-preview-panel-header'}"
                    CssStyleClasses="rim-heading label-heading" />
    <controls:CssBoxContainer Name="Loaded" FlexDirection="Column" Visible="False">
        <controls:CssBoxContainer Name="ViewBox" FlexDirection="Row" CssStyleIdentifier="preview-view-box" />
        <controls:CssBoxContainer FlexDirection="Row" CssStyleIdentifier="preview-buttons">
            <controls:CssButton Name="CharacterSetup"
                                Text="{Loc 'lobby-character-preview-panel-characters-setup-button'}"
                                CssStyleClasses="open-right" />
            <controls:CssButton Name="EquipmentSetup"
                                Text="{Loc 'lobby-character-preview-panel-equipment-setup-button'}"
                                CssStyleClasses="open-left" />
        </controls:CssBoxContainer>
    </controls:CssBoxContainer>
    <css:CssControl Name="Unloaded" Text="{Loc 'lobby-character-preview-panel-unloaded-preferences-label'}" />
</ui:RfLobbyCharacterPreviewPanel>

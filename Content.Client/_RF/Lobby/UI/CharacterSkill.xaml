<controls:RfBoxContainer
    xmlns="https://spacestation14.io"
    xmlns:suil="clr-namespace:Content.Client._RF.Suil"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    FlexDirection="Row"
    SuilStyleClasses="panel-highlighted">
    <controls:RfBoxContainer FlexDirection="Row" SetSize="36 36"
                              SuilStyleClasses="panel-light-bordered" SuilStyleIdentifier="skill-icon">
        <TextureRect Name="Texture" SetSize="24 24" Stretch="KeepAspectCentered" />
    </controls:RfBoxContainer>

    <suil:UiElement SuilStyleClasses="low-divider" SuilStyleIdentifier="skill-divider" />

    <suil:UiElement Name="NameLabel" />
    <suil:UiElement Name="CostLabel" SuilStyleIdentifier="skill-cost" />

    <suil:UiElement SuilStyleClasses="low-divider" SuilStyleIdentifier="skill-divider" />

    <controls:IntCounter Name="Levels" Access="Public" />
</controls:RfBoxContainer>

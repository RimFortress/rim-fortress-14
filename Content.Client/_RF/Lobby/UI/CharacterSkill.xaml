<Control
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    Margin="0 0 0 5" HorizontalExpand="True">
    <PanelContainer StyleClasses="PanelHighlighted">
        <BoxContainer>
            <PanelContainer StyleClasses="PanelLightBordered" SetSize="36 36">
                <TextureRect Name="Texture" SetSize="24 24"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stretch="KeepAspectCentered"/>
            </PanelContainer>

            <PanelContainer StyleClasses="LowDivider" Margin="5 2"/>

            <RichTextLabel Name="NameLabel"/>
            <Label Name="CostLabel" Align="Right" VAlign="Bottom"
                   VerticalExpand="True" HorizontalExpand="True"/>

            <PanelContainer StyleClasses="LowDivider" Margin="5 2"/>

            <controls:IntCounter Name="Levels" Access="Public"/>
        </BoxContainer>
    </PanelContainer>
</Control>

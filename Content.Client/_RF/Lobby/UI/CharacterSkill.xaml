<controls:CssBoxContainer
    xmlns="https://spacestation14.io"
    xmlns:css="clr-namespace:Content.Client._RF.CSS"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    FlexDirection="Row"
    CssStyleClasses="panel-highlighted">
    <controls:CssBoxContainer FlexDirection="Row" SetSize="36 36"
                              CssStyleClasses="panel-light-bordered" CssStyleIdentifier="skill-icon">
        <TextureRect Name="Texture" SetSize="24 24" Stretch="KeepAspectCentered" />
    </controls:CssBoxContainer>

    <css:CssControl CssStyleClasses="low-divider" CssStyleIdentifier="skill-divider" />

    <css:CssControl Name="NameLabel" />
    <css:CssControl Name="CostLabel" CssStyleIdentifier="skill-cost" />

    <css:CssControl CssStyleClasses="low-divider" CssStyleIdentifier="skill-divider" />

    <controls:IntCounter Name="Levels" Access="Public" />
</controls:CssBoxContainer>

<Control
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.Lobby.UI"
    xmlns:controls1="clr-namespace:Content.Client._RF.UserInterface.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    Margin="0 0 0 5" HorizontalExpand="True">
    <controls:RfHighlightedContainer>
        <BoxContainer>
            <controls:RfHighlightedContainer>
                <TextureRect Name="Texture" SetSize="24 24" Stretch="KeepAspectCentered"/>
            </controls:RfHighlightedContainer>
            <controls1:VLine Color="{x:Static style:StyleNano.NanoGold}"
                             Thickness="2" Margin="5 2"/>
            <RichTextLabel Name="NameLabel"/>
            <Label Name="CostLabel" Align="Right" VAlign="Bottom"
                   VerticalExpand="True" HorizontalExpand="True"/>
            <controls1:VLine Color="{x:Static style:StyleNano.NanoGold}"
                             Thickness="2" Margin="5 2"/>
            <controls1:IntCounter Name="Levels" Access="Public"/>
        </BoxContainer>
    </controls:RfHighlightedContainer>
</Control>

<ui:RfHumanoidProfileEditor
    xmlns="https://spacestation14.io"
    xmlns:suil="clr-namespace:Content.Client._RF.Suil"
    xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client._RF.Lobby.UI"
    xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls"
    FlexDirection="Column">
    <!-- Styled by Resources/UI/_RF/lobby/ -->
    <!-- Middle container -->
    <controls:RfBoxContainer FlexDirection="Row" SuilStyleIdentifier="profile-top">
        <!-- Name box-->
        <controls:RfBoxContainer FlexDirection="Column" SuilStyleClasses="panel-highlighted"
                                  SuilStyleIdentifier="profile-name-panel">
            <controls:RfBoxContainer FlexDirection="Row" SuilStyleIdentifier="profile-name-row">
                <suil:UiElement Text="{Loc 'humanoid-profile-editor-name-label'}" />
                <controls:RfLineEdit Name="NameEdit" />
                <controls:RfButton Name="NameRandomize" Text="{Loc 'humanoid-profile-editor-randomize'}" />
            </controls:RfBoxContainer>
            <controls:RfButton Name="RandomizeEverythingButton" SuilStyleIdentifier="profile-randomize-all"
                                Text="{Loc 'humanoid-profile-editor-randomize-everything'}" />
            <suil:UiElement Name="WarningLabel" SuilStyleClasses="danger" SuilStyleIdentifier="profile-warning" />
        </controls:RfBoxContainer>

        <suil:UiElement SuilStyleClasses="flex-fill" />

        <!-- Import/Export -->
        <controls:RfBoxContainer FlexDirection="Column" SuilStyleClasses="panel-dark-bordered"
                                  SuilStyleIdentifier="profile-export-panel">
            <controls:RfButton Name="ImportButton" Text="{Loc 'humanoid-profile-editor-import-button'}" />
            <controls:RfButton Name="ExportButton" Text="{Loc 'humanoid-profile-editor-export-button'}" />
            <controls:RfButton Name="ExportImageButton" Text="{Loc 'humanoid-profile-editor-export-image-button'}" />
            <controls:RfButton Name="OpenImagesButton" Text="{Loc 'humanoid-profile-editor-open-image-button'}" />
        </controls:RfBoxContainer>
    </controls:RfBoxContainer>

    <suil:UiElement MinHeight="10" />

    <!-- tabContainer -->
    <controls:RfTabContainer Name="Tabs" FlexGrow="1">
        <controls:RfBoxContainer Name="AppearanceTab" FlexDirection="Row"
                                  controls:RfTabContainer.TabTitle="{Loc 'humanoid-profile-editor-appearance-tab'}">
            <controls:RfScrollContainer SuilStyleClasses="scroll-vertical" SuilStyleIdentifier="profile-appearance-scroll">
                <controls:RfBoxContainer FlexDirection="Column">
                    <!-- Skin -->
                    <controls:RfBoxContainer FlexDirection="Column" SuilStyleClasses="panel-highlighted profile-block">
                        <suil:UiElement Text="{Loc 'humanoid-profile-editor-skin-color-label'}" />
                        <controls:RfSlider Name="Skin" MinValue="0" MaxValue="100" Value="20" />
                        <controls:RfBoxContainer Name="RgbSkinColorContainer" Visible="False" FlexDirection="Column" />
                    </controls:RfBoxContainer>
                    <!-- Eyes -->
                    <controls:RfBoxContainer FlexDirection="Column" SuilStyleClasses="panel-highlighted profile-block">
                        <suil:UiElement Text="{Loc 'humanoid-profile-editor-eyes-label'}" />
                        <controls:RfColorSelectorSliders Name="EyeColorPicker" SelectorType="Hsv" Margin="0 0 0 10" />
                    </controls:RfBoxContainer>
                    <!-- Markings -->
                    <controls:RfBoxContainer FlexDirection="Column"
                                              SuilStyleClasses="panel-highlighted profile-block profile-markings">
                        <suil:UiElement Text="{Loc 'humanoid-profile-editor-markings-tab'}" />
                        <ui:RfMarkingPicker Name="Markings" FlexGrow="1" />
                    </controls:RfBoxContainer>
                </controls:RfBoxContainer>
            </controls:RfScrollContainer>

            <suil:UiElement SuilStyleClasses="high-divider profile-divider" />

            <controls:RfBoxContainer FlexDirection="Column">
                <controls:RfBoxContainer FlexDirection="Row">
                    <!-- Sprite view -->
                    <controls:RfBoxContainer FlexDirection="Column"
                                              SuilStyleClasses="panel-dark-bordered"
                                              SuilStyleIdentifier="profile-sprite-panel">
                        <profile:ProfilePreviewSpriteView Name="SpriteView" Stretch="Fill"
                                                          MinSize="250 250" SizeFlagsStretchRatio="1"
                                                          VerticalExpand="True" HorizontalExpand="True" />
                        <controls:RfBoxContainer FlexDirection="Row" SuilStyleIdentifier="profile-rotate">
                            <controls:RfButton Name="SpriteRotateLeft" Text="◀" SuilStyleClasses="open-right" />
                            <controls:RfButton Name="SpriteRotateRight" Text="▶" SuilStyleClasses="open-left" />
                        </controls:RfBoxContainer>
                    </controls:RfBoxContainer>

                    <suil:UiElement SuilStyleClasses="flex-fill"/>

                    <controls:RfBoxContainer FlexDirection="Column" SuilStyleClasses="panel-highlighted"
                                              SuilStyleIdentifier="profile-options-panel">
                        <!-- Species -->
                        <controls:RfBoxContainer FlexDirection="Row">
                            <suil:UiElement Text="{Loc 'humanoid-profile-editor-species-label'}" />
                            <suil:UiElement SuilStyleClasses="flex-fill" />
                            <TextureButton Name="SpeciesInfoButton" Scale="0.3 0.3"
                                           VerticalAlignment="Center"
                                           ToolTip="{Loc 'humanoid-profile-editor-guidebook-button-tooltip'}" />
                        </controls:RfBoxContainer>
                        <controls:RfOptionButton Name="SpeciesButton" />
                        <suil:UiElement SuilStyleClasses="low-divider profile-divider" />
                        <!-- Age -->
                        <suil:UiElement Text="{Loc 'humanoid-profile-editor-age-label'}" />
                        <controls:RfLineEdit Name="AgeEdit" MinSize="40 0" />
                        <suil:UiElement SuilStyleClasses="low-divider profile-divider" />
                        <!-- Sex -->
                        <suil:UiElement Text="{Loc 'humanoid-profile-editor-sex-label'}" />
                        <controls:RfOptionButton Name="SexButton" />
                        <suil:UiElement SuilStyleClasses="low-divider profile-divider" />
                        <!-- Pronouns -->
                        <suil:UiElement Text="{Loc 'humanoid-profile-editor-pronouns-label'}" />
                        <controls:RfOptionButton Name="PronounsButton" />
                        <suil:UiElement SuilStyleClasses="low-divider profile-divider" />
                        <!-- Show clothing -->
                        <suil:UiElement Text="{Loc 'humanoid-profile-editor-clothing'}" />
                        <controls:RfButton Name="ShowClothes" Pressed="True" ToggleMode="True"
                                            Text="{Loc 'humanoid-profile-editor-clothing-show'}" />
                    </controls:RfBoxContainer>
                </controls:RfBoxContainer>

                <suil:UiElement SuilStyleClasses="flex-fill"/>
            </controls:RfBoxContainer>
        </controls:RfBoxContainer>
        <ui:CharacterSkillsTab Name="SkillsTab" Margin="10"
                               controls:RfTabContainer.TabTitle="{Loc 'humanoid-profile-editor-skills-tab'}" />
        <controls:RfBoxContainer Name="TraitsTab" FlexDirection="Column" Margin="10"
                                  controls:RfTabContainer.TabTitle="{Loc 'humanoid-profile-editor-traits-tab'}">
            <!-- Traits -->
            <controls:RfScrollContainer SuilStyleClasses="scroll-vertical" SuilStyleIdentifier="profile-traits-scroll">
                <controls:RfBoxContainer Name="TraitsList" FlexDirection="Column" />
            </controls:RfScrollContainer>
        </controls:RfBoxContainer>
    </controls:RfTabContainer>
</ui:RfHumanoidProfileEditor>

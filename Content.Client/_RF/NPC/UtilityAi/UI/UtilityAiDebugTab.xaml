<controls:UtilityAiDebugTab
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.NPC.UtilityAi.UI"
    xmlns:npc="clr-namespace:Content.Client._RF.NPC.UI"
    NodeSize="350 400">
    <PanelContainer StyleClasses="PanelDark"/>

    <npc:DraggableScrollContainer Name="ScrollContainer"
                                  HorizontalExpand="True"
                                  VerticalExpand="True">
        <Control Name="GraphRoot">
            <npc:UtilityAiGraphEdgeOverlay Name="EdgeOverlay"/>
            <LayoutContainer Name="NodesLayer" />
        </Control>
    </npc:DraggableScrollContainer>
</controls:UtilityAiDebugTab>

<controls:AiDevWindowTab
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.NPC.UI"
    xmlns:ui="clr-namespace:Content.Client._RF.NPC.GOAP.UI"
    NodeSize="350 400" MouseFilter="Pass" ZoomStep="0.05">
    <PanelContainer StyleClasses="PanelDark"/>

    <controls:DraggableScrollContainer Name="ScrollContainer"
                                       Access="Protected"
                                       HorizontalExpand="True"
                                       VerticalExpand="True"
                                       HScrollBarHidden="True"
                                       VScrollBarHidden="True"
                                       HScroll="1000"
                                       VScroll="1000">
        <LayoutContainer Name="GraphRoot" Margin="1000"/>
        <controls:GraphEdgeOverlay Name="EdgeOverlay" Margin="1000"/>
    </controls:DraggableScrollContainer>

    <Control Name="ExpandedContainer"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"/>

    <LayoutContainer>
        <ui:DraggablePanel Name="SearchPanel" Title="Search">
            <LineEdit Name="Search" SetWidth="150"/>
        </ui:DraggablePanel>
    </LayoutContainer>

    <Control Name="Content"/>
</controls:AiDevWindowTab>

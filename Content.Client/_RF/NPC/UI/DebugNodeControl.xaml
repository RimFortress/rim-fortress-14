<controls:DebugNodeControl
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.NPC.UI"
    MouseFilter="Pass">
    <PanelContainer StyleClasses="PanelHighlighted"/>

    <BoxContainer Orientation="Vertical" Margin="1">
        <Control>
            <PanelContainer StyleClasses="PanelDark"/>
            <BoxContainer Margin="5 5 8 0">
                <RichTextLabel Name="Title"/>
                <Control HorizontalExpand="True"/>
                <RichTextLabel Name="SubTitle"/>
            </BoxContainer>
        </Control>
        <PanelContainer StyleClasses="LowDivider"/>

        <ScrollContainer Name="Content" HorizontalExpand="True" VerticalExpand="True"/>

        <RichTextLabel Name="StatusLabel" StyleClasses="LabelSubText" Margin="5 0"/>
    </BoxContainer>
</controls:DebugNodeControl>

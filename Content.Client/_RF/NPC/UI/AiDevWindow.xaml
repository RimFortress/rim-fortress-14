<controls:AiDevWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.NPC.UI"
    xmlns:goap="clr-namespace:Content.Client._RF.NPC.GOAP.UI"
    xmlns:utility="clr-namespace:Content.Client._RF.NPC.UtilityAi.UI"
    xmlns:search="clr-namespace:Content.Client._RF.NPC.Search.UI">
    <PanelContainer StyleClasses="PanelLight"/>
    <BoxContainer Orientation="Vertical">
        <BoxContainer Margin="5 5 5 0">
            <BoxContainer HorizontalExpand="True" Orientation="Vertical">
                <Label Name="TargetLabel"/>
                <Label Name="TimeLabel"/>
                <Label Name="TickLabel"/>
            </BoxContainer>
            <BoxContainer Orientation="Vertical">
                <Button Name="Refresh" Text="Refresh" Disabled="True"/>
            </BoxContainer>
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider"/>

        <TabContainer Name="TabContainer" VerticalExpand="True">
            <goap:GoapDebugTab Name="GoapDebugTab"/>
            <utility:UtilityAiDebugTab Name="UtilityAiDebugTab"/>
            <search:SearcherDebugTab Name="SearcherDebugTab"/>
        </TabContainer>
    </BoxContainer>
</controls:AiDevWindow>

<controls:DraggablePanel
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.NPC.GOAP.UI"
    MouseFilter="Pass">
    <PanelContainer StyleClasses="PanelLightBordered"/>
    <BoxContainer Orientation="Vertical" Margin="1">
        <Control Name="Drag" MouseFilter="Pass">
            <PanelContainer StyleClasses="PanelDark"/>
            <BoxContainer Margin="5 5 8 0">
                <Label Name="Label"/>
            </BoxContainer>
        </Control>
        <PanelContainer StyleClasses="LowDivider"/>

        <BoxContainer Name="Contents" Margin="2" Orientation="Vertical"/>
    </BoxContainer>
</controls:DraggablePanel>

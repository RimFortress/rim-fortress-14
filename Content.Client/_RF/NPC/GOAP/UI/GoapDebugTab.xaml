<controls:GoapDebugTab
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.NPC.GOAP.UI"
    NodeSize="350 400">
    <PanelContainer StyleClasses="PanelDark"/>

    <controls:DraggableScrollContainer HorizontalExpand="True" VerticalExpand="True">
        <Control Name="GraphRoot">
            <controls:GoapGraphEdgeOverlay Name="EdgeOverlay" />
            <LayoutContainer Name="NodesLayer" />
        </Control>
    </controls:DraggableScrollContainer>

    <Control Name="PlanPanel" Margin="50"
             HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <PanelContainer StyleClasses="PanelLightBorderedTransparent"/>
        <BoxContainer Orientation="Vertical" Margin="1">
            <Control>
                <PanelContainer StyleClasses="PanelDarkTransparent"/>
                <BoxContainer Margin="5 5 8 0">
                    <Label Text="Planning Info"/>
                </BoxContainer>
            </Control>
            <PanelContainer StyleClasses="LowDivider"/>

            <BoxContainer Margin="2" Orientation="Vertical">
                <RichTextLabel Name="TotalCost" Margin="5 0"/>
                <PanelContainer StyleClasses="LowDividerDark" Margin="3 2"/>

                <RichTextLabel Name="NodesExpanded" Margin="5 0"/>
                <PanelContainer StyleClasses="LowDividerDark" Margin="3 2"/>

                <RichTextLabel Name="Planning" Margin="5 0"/>
                <PanelContainer StyleClasses="LowDividerDark" Margin="3 2"/>

                <RichTextLabel Name="ElapsedTime" Margin="5 0"/>
                <PanelContainer StyleClasses="LowDividerDark" Margin="3 2"/>

                <controls:ExpandableBox Name="StartState" Title="[bold]Start State[/bold]"/>
                <PanelContainer StyleClasses="LowDividerDark" Margin="3 2"/>

                <controls:ExpandableBox Name="GoalState" Title="[bold]Goal State[/bold]"/>
                <PanelContainer StyleClasses="LowDividerDark" Margin="3 2"/>
            </BoxContainer>
        </BoxContainer>
    </Control>
</controls:GoapDebugTab>

<controls:GraphNodeControl
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.NPC.GOAP.UI">
    <PanelContainer StyleClasses="PanelHighlighted"/>

    <BoxContainer Orientation="Vertical" Margin="1">
        <Control>
            <PanelContainer StyleClasses="PanelDark"/>
            <BoxContainer Margin="5 5 8 0">
                <Label Name="Title"/>
                <Control HorizontalExpand="True"/>
                <RichTextLabel Name="StatusLabel"/>
            </BoxContainer>
        </Control>
        <PanelContainer StyleClasses="LowDivider"/>

        <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
            <TabContainer Name="TabContainer" VerticalExpand="True"
                          HorizontalExpand="True">
                <BoxContainer Name="CommonTab" Orientation="Vertical"/>
                <BoxContainer Name="ActionsTab" Orientation="Vertical"/>
                <BoxContainer Name="PreconditionsTab" Orientation="Vertical"/>
            </TabContainer>
        </ScrollContainer>
    </BoxContainer>
</controls:GraphNodeControl>

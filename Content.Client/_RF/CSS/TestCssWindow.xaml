<controls:TestCssWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.CSS"
    MinSize="800 600" Title="CSS Debug Window">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer>
            <Label Text="ID:"/>
            <LineEdit Name="IdEdit" SetWidth="150"/>
            <Label Text="PseudoClasses:"/>
            <LineEdit Name="PseudoEdit" HorizontalExpand="True"/>
            <Label Text="StyleClasses:"/>
            <LineEdit Name="StyleEdit" HorizontalExpand="True"/>
            <Button Name="ReloadButton" Text="Reload"/>
        </BoxContainer>
        <controls:TestCssWindowControl Name="TestControl" MouseFilter="Pass"
                                       HorizontalExpand="True" VerticalExpand="True"/>
    </BoxContainer>
</controls:TestCssWindow>

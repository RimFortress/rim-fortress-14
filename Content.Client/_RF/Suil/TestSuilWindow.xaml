<controls:TestSuilWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RF.Suil"
    MinSize="800 600" Title="SUIL Debug Window">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer>
            <Label Text="ID:"/>
            <LineEdit Name="IdEdit" SetWidth="150"/>
            <Label Text="PseudoClasses:"/>
            <LineEdit Name="PseudoEdit" HorizontalExpand="True"/>
            <Label Text="StyleClasses:"/>
            <LineEdit Name="StyleEdit" HorizontalExpand="True"/>
            <Button Name="ReloadButton" Text="Reload"/>
        </BoxContainer>
        <controls:TestSuilWindowControl Name="TestControl" MouseFilter="Pass" Text="Test text"
                                       HorizontalExpand="True" VerticalExpand="True"/>
    </BoxContainer>
</controls:TestSuilWindow>

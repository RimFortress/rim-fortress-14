<Control xmlns="https://spacestation14.io"
         xmlns:pllax="clr-namespace:Content.Client.Parallax"
         xmlns:controls="clr-namespace:Content.Client._RF.UserInterface.Controls"
         xmlns:suil="clr-namespace:Content.Client._RF.Suil">
    <pllax:ParallaxControl
        Name="BackgroundParallax"
        StyleClasses=""
        SpeedX="5"
        SpeedY="20"
        ScaleX="3"
        ScaleY="3" />
    <!-- RimFortress: styled by Resources/UI/_RF/main-menu/main-menu.suil -->
    <controls:RfBoxContainer Name="VBox"
                              FlexDirection="Column"
                              SuilStyleIdentifier="main-menu"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              HorizontalExpand="True"
                              VerticalExpand="True">
        <TextureRect Name="Logo"
                     TexturePath="/Textures/_RF/Logo/logo.png"
                     TextureScale="3 3"
                     Stretch="KeepCentered" />
        <controls:RfBoxContainer Name="Panel"
                                  FlexDirection="Column"
                                  SuilStyleClasses="angle-rect-transparent">
            <controls:RfBoxContainer Name="Fields"
                                      FlexDirection="Column"
                                      SuilStyleIdentifier="main-menu-fields">
                <controls:RfBoxContainer FlexDirection="Row">
                    <suil:UiElement Name="UsernameLabel"
                                    Text="{Loc 'main-menu-username-label'}" />
                    <controls:RfLineEdit Name="UsernameBox"
                                          Access="Public"
                                          PlaceHolder="{Loc 'main-menu-username-text'}"
                                          FlexGrow="1" />
                </controls:RfBoxContainer>
                <controls:RfBoxContainer FlexDirection="Row">
                    <suil:UiElement Name="AddressLabel"
                                    Text="{Loc 'main-menu-address-label'}" />
                    <controls:RfLineEdit Name="AddressBox"
                                          Access="Public"
                                          Text="localhost"
                                          PlaceHolder="server address:port"
                                          FlexGrow="1" />
                </controls:RfBoxContainer>
            </controls:RfBoxContainer>
            <controls:RfButton Name="DirectConnectButton"
                                Access="Public"
                                SuilStyleClasses="main-menu-button open-both"
                                Text="{Loc 'main-menu-direct-connect-button'}" />
            <controls:RfChangelogButton Name="ChangelogButton"
                                         SuilStyleClasses="main-menu-button open-both"
                                         Access="Public" />
            <controls:RfButton Name="OptionsButton"
                                Access="Public"
                                SuilStyleClasses="main-menu-button open-both"
                                Text="{Loc 'main-menu-options-button'}" />
            <controls:RfButton Name="QuitButton"
                                Access="Public"
                                SuilStyleClasses="main-menu-button open-both negative"
                                Text="{Loc 'main-menu-quit-button'}" />
        </controls:RfBoxContainer>
    </controls:RfBoxContainer>
</Control>

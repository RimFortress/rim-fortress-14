/* ---------- Context Menu ---------- */

/* ContextMenuPopup.StyleClassContextMenuPopup: contextMenuPopup (ContextMenuElement.ElementMargin = 2) */
.context-menu-popup {
    background-image: texture("/Textures/_RF/Interface/Style/window_background_bordered.png");
    background-repeat: stretch;
    patch-margin: 2px;
    padding: 2px;
}

/* ContextMenuElement.StyleClassContextMenuButton: contextMenuButton */
.context-menu-button {
    background-color: var(--graphite-black);
}

.context-menu-button:hover {
    background-color: var(--signal-black);
}

.context-menu-button:active,
.context-menu-button:checked {
    background-color: var(--wooden-fortress);
}

.context-menu-button:disabled {
    background-color: var(--black-amber);
}

/* ConfirmationMenuElement.StyleClassConfirmationContextMenuButton: confirmationContextMenuButton */
.confirmation-context-menu-button {
    background-color: var(--bad);
}

.confirmation-context-menu-button:hover {
    background-color: var(--light-bad);
}

.confirmation-context-menu-button:active,
.confirmation-context-menu-button:checked {
    background-color: var(--dark-bad);
}

.confirmation-context-menu-button:disabled {
    background-color: var(--darkest-bad);
}

/* Verb.DefaultTextStyleClass: Verb, InteractionVerb, AlternativeVerb, ActivationVerb */
.interaction-verb {
    font-weight: bold;
    font-style: italic;
}

.activation-verb {
    font-weight: bold;
}

.alternative-verb {
    font-style: italic;
}

.verb {
    font-weight: normal;
    font-style: normal;
}

/*
 * ContextMenuElement.StyleClassContextMenuExpansionTexture: contextMenuExpansionTexture
 * VerbMenuElement.StyleClassVerbMenuConfirmationTexture: verbMenuConfirmationTexture
 *   Both were a TextureRect with the texture below. There is no CssTextureRect, so the CssControl that replaces
 *   it draws the texture as its background.
 */
.context-menu-expansion-texture,
.verb-menu-confirmation-texture {
    background-image: texture("/Textures/Interface/VerbIcons/group.svg.192dpi.png");
    background-repeat: no-repeat;
}

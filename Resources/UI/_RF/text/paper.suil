/* ---------- Paper ---------- */

/* PaperWrittenText */
.paper-written-text {
    font-size: 12px;
    color: var(--black-amber);
}

/* ---------- Window / PDA text ---------- */

/* PdaContentFooterText */
.pda-content-footer-text {
    font-size: 10px;
    color: var(--pda-footer-text);
}

/* PdaWindowFooterText */
.pda-window-footer-text {
    font-size: 10px;
    color: var(--pda-window-footer-text);
}

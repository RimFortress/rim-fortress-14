/* ---------- Backgrounds of the open buttons ---------- */

/* BackgroundOpenRight */
.background-open-right {
    background-image: texture("/Textures/_RF/Interface/Style/button_open_right.png");
    background-repeat: stretch;
    background-color: <graphite-black>;
    patch-margin: 11px 5px 11px 11px;
    padding: 7px 10px 7px 12px;
}

/* BackgroundOpenLeft */
.background-open-left {
    background-image: texture("/Textures/_RF/Interface/Style/button_open_left.png");
    background-repeat: stretch;
    background-color: <graphite-black>;
    patch-margin: 11px 11px 11px 5px;
    padding: 7px 12px 7px 9px;
}

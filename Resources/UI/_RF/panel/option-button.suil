.option-triangle {
    min-width: 18px;
    min-height: 18px;
    background-image: texture("/Textures/_RF/Interface/chevron-left-solid-full.svg.192dpi.png");
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    background-color: <gold-fortress>;
    align-self: center;
}

rf-option-button:checked .option-triangle {
    background-image: texture("/Textures/_RF/Interface/chevron-down-solid-full.svg.192dpi.png");
}

.option-button-panel {
    background-color: color-mix(in srgb, <signal-black> 90%, transparent);
    border: solid 1px <graphite-black>;
}

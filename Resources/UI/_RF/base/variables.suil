/*
 * Constants of the Rim Fortress theme (StyleFortress.cs: Colors). Imported into every file by /global-usings.
 */
let main-font = "Source Code Pro";
let title-font = "Boxfont Round";

/* Base colors */
let gold-fortress = #B07D2B;
let rim-silver = #C0C0C0;

let black-amber = #0B0C0B;
let graphite-black = #1A1D1A;
let dark-forest = #293329;
let bright-green = #4E544E;

let light-good = #6EAD54;
let good = #61A53E;
let dark-good = #589338;
let darkest-good = #416D29;

let light-bad = #BF2233;
let bad = #9B111E;
let dark-bad = #8B0000;
let darkest-bad = #681C23;

/* Buttons */

/* ---------- Top menu ---------- */

/* MenuButton.StyleClassLabelTopButton: topButtonLabel */
.top-button-label {
    font-weight: bold;
    font-size: 14px;
}

/* ---------- Storage Button ---------- */

/* storageButton: thin buttons (no padding nor vertical margin) */
.storage-button {
    background-image: texture("/Textures/_RF/Interface/Style/button.png");
    background-repeat: stretch;
    patch-margin: 0;
    padding: 0 4px;
}

.storage-button {
    background-color: var(--button-color-default);
}

.storage-button:hover {
    background-color: var(--button-color-hovered);
}

.storage-button:active,
.storage-button:checked {
    background-color: var(--button-color-pressed);
}

.storage-button:disabled {
    background-color: var(--button-color-disabled);
}

/* ---------- ListContainer ---------- */

/* ListContainer.StyleClassListContainerButton: list-container-button */
.list-container-button {
    padding-left: 10px;
    background-color: rgb(55, 55, 68);
}

.list-container-button:hover,
.list-container-button:active,
.list-container-button:checked {
    background-color: rgb(75, 75, 86);
}

.list-container-button:disabled {
    background-color: rgb(10, 10, 12);
}

/* ---------- Chat Channel Selector ---------- */

/* chatSelectorOptionButton */
.chat-selector-option-button {
    background-image: texture("/Textures/_RF/Interface/Style/rounded_button.png");
    background-repeat: stretch;
    patch-margin: 5px;
    padding: 7px;
}

/* chatFilterOptionButton */
.chat-filter-option-button {
    background-image: texture("/Textures/_RF/Interface/Style/rounded_button_bordered.png");
    background-repeat: stretch;
    patch-margin: 5px;
    padding: 7px;
    background-color: var(--button-color-default);
}

.chat-filter-option-button:hover {
    background-color: var(--button-color-hovered);
}

.chat-filter-option-button:active,
.chat-filter-option-button:checked {
    background-color: var(--button-color-pressed);
}

.chat-filter-option-button:disabled {
    background-color: var(--button-color-disabled);
}

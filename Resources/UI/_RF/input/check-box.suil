/* ---------- CheckBox (CssCheckBox: the .indicator is the box, .checked is set while it is checked) ---------- */

/*
 * The indicator and the label are not the children of the check box but of its inner box, so they are
 * selected as descendants (`css-check-box .indicator`).
 *
 * css-check-box is a css-button, so it would take the look of a button (the colors of css-button:hover, :active, :checked
 * and :disabled): it is reset here to a transparent control, the rules are of the same specificity and come later.
 */

/* CheckBox.StyleClassCheckBox: checkBox */
css-check-box {
    border: none;
    border-image: none;
    background-image: none;
    background-color: transparent;
    padding: 0;
    gap: 10px;
    text-align: left;
}

/*
 * The indicator and the label are laid out by the box inside of the check box, and the box is a box,
 * which has a gap of its own (root.css). Without this rule, every restyle of the box (on :hover of the check box, for
 * one) brings that gap back and the gap of the check box is lost.
 */
css-check-box > box {
    gap: inherit;
}

css-check-box:hover,
css-check-box:active,
css-check-box:checked {
    border-color: transparent;
    background-color: transparent;
}

css-check-box:disabled {
    border-color: transparent;
    background-color: transparent;
}

/* The indicator has no content, so its size (the size of the textures) is set here. */
css-check-box .indicator {
    min-width: 20px;
    min-height: 20px;
    background-image: texture("/Textures/_RF/Interface/Style/checkbox_unchecked.png");
    background-repeat: no-repeat;
}

/* CheckBox.StyleClassCheckBoxChecked: checkBoxChecked */
css-check-box .indicator.checked {
    background-image: texture("/Textures/_RF/Interface/Style/checkbox_checked.png");
}

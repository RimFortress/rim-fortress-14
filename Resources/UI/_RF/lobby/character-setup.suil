/* ---------- RfCharacterSetupGui ---------- */

character-setup-gui {
    flex-grow: 1;
}

#setup-body {
    flex-grow: 1;
}

#setup-characters {
    min-width: 350px;
    margin: 5px 0 0 5px;
}

#setup-characters-count {
    min-height: 30px;
}

#setup-editor {
    flex-grow: 1;
}

/* RfCharacterPickerButton: the description has the name and the profession on two lines */
#picker-description {
    max-width: 150px;
    align-self: flex-start;
    white-space: pre-line;
}

#save-panel {
    gap: 4px;
}

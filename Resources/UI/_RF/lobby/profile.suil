/* ---------- RfHumanoidProfileEditor ---------- */

rf-humanoid-profile-editor {
    flex-grow: 1;
    padding: 10px;
}

#profile-top {
    gap: 10px;
}

#profile-name-row {
    gap: 5px;
}

#profile-name-row > css-line-edit {
    min-width: 270px;
    align-self: center;
}

#profile-randomize-all {
    align-self: center;
    max-width: 256px;
}

#profile-warning {
    align-self: flex-start;
    max-width: 425px;
}

#profile-export-panel {
    min-width: 60px;
}

#profile-sprite-panel {
    margin: 3px;
}

#profile-rotate {
    align-self: center;
}

#profile-options-panel {
    min-width: 165px;
    margin: 3px;
}

.profile-divider {
    margin: 2px;
}

.profile-block {
    margin: 10px;
}

/* The hints of the traits tab */
.profile-hint {
    color: var(--gray-silver);
}

/* A trait that doesn't fit in the points of its category (RfTraitPreferenceSelector) */
css-check-box.over-limit .label {
    color: var(--light-bad);
}

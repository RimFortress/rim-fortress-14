/* The panel of the notifications in the corner of the screen. */
@NotificationsPanelWidget => box-container (set-size: 300 500) {
    col (horizontal-expand) {
        row #header .panel-dark-bordered (visible: false, margin: 2) {
            _ .label-key-text (
                text: $notifications-panel-label,
                align-self: center,
                margin: 0 3
            )
            _ .flex-fill
            icon-button #settings (
                "<icons>/gear-solid-full.svg.192dpi.png",
                tool-tip: $notification-settings-tooltip,
                set-size: 24,
                on-pressed => @Controllers.NotificationsSettings.ToggleWindow
            )
        }

        scroll-container #scroll (overflow-x: hidden, visible: false, flex-grow: 1) {
            col #notifications (gap: 3px)
        }
    }
}

/*
 * One notification: the button with the name and the time, the bar of the time left under the text, and the description
 * that opens under the button.
 */
@NotificationButton => col {
    button #button .square (toggle-mode, on-pressed => @OnButtonPressed) {
        row {
            _ #name-label (margin: 0 3, flex-grow: 1)
            _ #time-label (margin: 0 3)
        }

        _ #progress-bar (set-height: 3, align-self: flex-start, visible: false)
    }

    box #desc-container .panel-dark-bordered-transparent (
        flex-grow: 1,
        visible: false
    ) {
        col (flex-grow: 1) {
            _ #desc (max-width: 280)
            _ .low-divider-dark (margin: 1 3)
            icon-button #focus-button (
                "<icons>/location-dot-solid-full.svg.192dpi.png",
                tool-tip: $notification-focus-tooltip,
                set-size: 24,
                align-self: flex-end,
                on-pressed => @OnFocusPressed
            )
        }
    }
}

/* The window with the list of notifications to mute. */
@NotificationsSettingsWindow => window (
    title: $notifications-settings-window-title,
    set-size: 250 300,
    resizable: false
) {
    col {
        _ (text: $notifications-settings-window-ignore)
        _ .low-divider-dark (margin: 1 3)
        scroll-container (flex-grow: 1) {
            col #container
        }
    }
}

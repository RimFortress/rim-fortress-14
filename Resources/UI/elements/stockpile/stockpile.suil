/* An item of the stockpile settings: the picture, the name, how many to keep or "no limit". */
@StockpileItemButton => button .square (
    min-height: 50,
    horizontal-expand,
    margin: 0 2 5 2,
    tracking-tooltip
) {
    row (flex-grow: 1) {
        _ .low-divider-dark (margin: 2)

        box .panel-light-bordered (
            set-size: 52,
            justify-content: center,
            align-items: center
        ) {
            +layered-texture #texture (set-size: 48)
        }

        _ .low-divider (margin: 2 5)
        _ #name-label (flex-grow: 1)

        row .panel-highlighted-transparent (padding: 0 3px) {
            +int-counter #counter (min-value: 0)
            +checkbox #unlimited-check (
                tool-tip: $stockpile-settings-menu-unlimited-checkbox-disabled-tooltip,
                tracking-tooltip
            )
        }
    }
}

/* The window of a stockpile: the items to keep (with the search) and the look of the zone, and the buttons under them. */
@StockpileSettingsWindow => window (min-size: 500 750) {
    col {
        tab #tab (flex-grow: 1) {
            col {
                box #address-box .panel-light {
                    _ #address .label-heading (margin: 0 0 0 8, align-self: center)
                }

                row #search-bar .panel-dark {
                    icon-button #back-button (
                        "/Textures/Interface/VerbIcons/close.svg.192dpi.png",
                        set-size: 32
                    )

                    line-edit #search (
                        place-holder: $stockpile-settings-menu-search-placeholder,
                        flex-grow: 1,
                        margin: 2 3
                    )
                }

                scroll-container (flex-grow: 1) {
                    col #item-list (flex-grow: 1)
                }
            }

            scroll-container {
                col {
                    zone-change-name-control #name-change
                    _ .low-divider (margin: 5 3)
                    zone-visuals-control #visuals-control
                }
            }
        }

        _ .high-divider

        row (margin: 3, gap: 5px) {
            framed-icon-button #expand-stock-button .square (
                "<icons>/expand-solid-full.svg.192dpi.png",
                tool-tip: $expand-stockpile-button-tooltip,
                set-size: 32
            )

            framed-icon-button #shrink-stock-button .square (
                "<icons>/VerbIcons/eraser-solid.svg.192dpi.png",
                tool-tip: $shrink-stockpile-button-tooltip,
                set-size: 32
            )

            framed-icon-button #suppliers-button .square (
                "<icons>/right-to-bracket-solid-full.svg.192dpi.png",
                tool-tip: $stockpile-suppliers-button-tooltip,
                set-size: 32
            )

            confirm-button #delete-stock-button .icon-button .square (
                confirmation-text: "",
                tool-tip: $delete-stockpile-button-tooltip,
                set-size: 32
            ) {
                _ .icon (background-image: texture("<icons>/ban-solid-full.svg.192dpi.png"))
            }
        }
    }
}

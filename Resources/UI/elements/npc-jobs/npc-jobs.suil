/* A task of a job in the settings: its name and the check box. */
@NpcTaskButton => row (tracking-tooltip, margin: 3 2) {
    _ #label .label-key-text (flex-grow: 1)
    +checkbox #check-box
}

/* The priority of a job: a square that shows the number, the click raises it, the right click lowers it. */
@NpcJobPriorityButton => box .bordered-window-panel (
    set-size: 32,
    min-value: 0,
    max-value: 10,
    min-color: #228B22,
    max-color: #CD5C5C,
    mouse-filter: stop,
    justify-content: center,
    align-items: center
) {
    _ #label
}

/* A cell of the table of priorities: the portrait of a pop and its name. */
@NpcJobsPopCell => row {
    box .panel-highlighted {
        sprite-view #icon (override-direction: south, set-size: 48, stretch: fill, margin: 2)
    }

    _ #name-label (margin: 0 5, flex-grow: 1)
}

/* A job in the settings: the icon (click to change), the name (can be edited), the buttons to rename and to delete. */
@NpcJobButton => button .square (horizontal-expand, toggle-mode) {
    row {
        box .panel-highlighted {
            +texture-switch-button #icon (
                set-size: 24,
                horizontal-alignment: center,
                vertical-alignment: center,
                textures-collection: "/Textures/_RF/Interface/VerbIcons/list-check-solid.svg.192dpi.png /Textures/_RF/Interface/VerbIcons/skull-crossbones-solid.svg.192dpi.png /Textures/_RF/Interface/VerbIcons/person-digging-solid.svg.192dpi.png /Textures/_RF/Interface/VerbIcons/hand-holding-medical-solid.svg.192dpi.png /Textures/_RF/Interface/VerbIcons/tree-solid.svg.192dpi.png /Textures/_RF/Interface/cubes-solid.svg.192dpi.png /Textures/_RF/Interface/VerbIcons/hand-solid.svg.192dpi.png /Textures/_RF/Interface/VerbIcons/house-flag-solid-full.svg.192dpi.png /Textures/_RF/Interface/VerbIcons/left-right-solid.svg.192dpi.png /Textures/_RF/Interface/VerbIcons/hand-pointer-solid.svg.192dpi.png /Textures/_RF/Interface/hammer-solid.svg.192dpi.png /Textures/_RF/Interface/VerbIcons/trowel-bricks-solid.svg.192dpi.png /Textures/_RF/Interface/VerbIcons/seedling-solid.svg.192dpi.png"
            )
        }

        _ .low-divider-dark (margin: 2)

        box #label-container .panel-dark-bordered (flex-grow: 1) {
            _ #name-label (flex-grow: 1, align-self: center)
        }

        line-edit #name-edit (flex-grow: 1, visible: false, on-text-entered => @OnNameEntered)

        button #edit-name-button .icon-button .square (set-size: 35, on-pressed => @OnEditNamePressed) {
            _ .icon (background-image: texture("/Textures/_RF/Interface/eye-dropper-solid.svg.192dpi.png"))
        }

        confirm-button #delete-button .icon-button .square (set-size: 35, confirmation-text: "", on-pressed => @OnDeletePressed) {
            _ .icon (background-image: texture("/Textures/_RF/Interface/ban-solid-full.svg.192dpi.png"))
        }
    }
}

/* The table of the priorities of the jobs of the pops. */
@NpcJobsPriorityWindow => fancy-window (title: $npc-jobs-priority-window-title, min-size: 940 590) {
    col {
        table-control #table (flex-grow: 1)

        fancy-back (margin: 0 0 5 0) {
            row {
                button #job-settings-button (
                    margin: 0 3,
                    text: $npc-jobs-priority-window-settings-button-text,
                    on-pressed => @OnJobSettingsPressed
                )
            }
        }
    }
}

/* The jobs (left) and the tasks of the chosen job (right). */
@NpcJobsSettingsWindow => fancy-window (title: $npc-jobs-settings-window-title, min-size: 700 600) {
    row {
        box .panel-dark-bordered {
            col {
                scroll-container (flex-grow: 1) {
                    col #jobs-container (flex-grow: 1)
                }

                box .panel-highlighted {
                    row {
                        button #save-button .accept (
                            flex-grow: 1,
                            text: $npc-jobs-settings-window-save-button,
                            on-pressed => @OnSavePressed
                        )
                        button #create-role-button (
                            flex-grow: 1,
                            text: $npc-jobs-settings-window-create-button,
                            on-pressed => @OnCreateRolePressed
                        )
                    }
                }
            }
        }

        _ .low-divider-dark (margin: 2 1)

        box .panel-light-bordered (flex-grow: 1) {
            col (flex-grow: 1) {
                box .panel-highlighted {
                    _ .fancy-window-title (text: $npc-jobs-settings-window-tasks-label, flex-grow: 1, align-self: center)
                }

                _ .low-divider-dark (margin: 1 2)

                scroll-container (flex-grow: 1) {
                    box .panel-highlighted (flex-grow: 1) {
                        col #tasks-container (flex-grow: 1)
                    }
                }
            }
        }
    }
}

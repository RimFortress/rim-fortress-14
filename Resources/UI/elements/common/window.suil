/* The look of a window: the panel, the header with the title and the buttons, the area of the contents. */
@RfWindowChrome => col .angle-rect {
    row .window-heading-background {
        _ #title-label .window-title (
            flex-grow: 1,
            align-self: center,
            overflow: hidden,
            text-overflow: ellipsis
        )

        button #help-button .window-help-button (
            set-size: 22 22,
            align-self: center,
            visible: false,
            on-pressed => @HelpPressed
        )

        button #close-button .cross-button-red (
            set-size: 22 22,
            align-self: center,
            on-pressed => @ClosePressed
        )
    }
    _ .low-divider
    _ #contents (flex-grow: 1, margin: 2px, overflow: hidden)
}

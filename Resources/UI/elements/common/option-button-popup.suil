/* The list of an option button */
@RfOptionButtonPopup => popup {
    +scroll-container #scroll .option-button-panel (return-measure, max-height: 300) {
        col {
            +line-edit #filter-box (visible: false, select-all-on-focus, place-holder: $option-button-filter)
            +col #items-box
        }
    }
}

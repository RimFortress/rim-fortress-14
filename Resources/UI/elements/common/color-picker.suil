/* The swatch of the chosen color and the button that opens the window with the sliders. */
@ColorPicker => row {
    _ #color-panel (min-width: 30, min-height: 30, margin: 4, horizontal-alignment: right, vertical-alignment: center)

    framed-icon-button #pick-color .square (
        "<icons>/eye-dropper-solid.svg.192dpi.png",
        min-width: 32,
        min-height: 32,
        tool-tip: $color-picker-tooltip,
        on-pressed => @OnPickPressed
    )
}

@IntCounter => row #root {
    button #plus .open-right (
        text: "+",
        margin: 2px 1px,
        on-pressed => &.value +: 1
    )
    line-edit #count-line (min-width: 50px, margin: 5px 0)
    button #minus .open-left (
        text: "-",
        margin: 2px 1px,
        on-pressed => &.value -: 1
    )
}

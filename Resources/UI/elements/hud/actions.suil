/* The hotbar: the tree of the buttons of the commands. */
@ActionsHotbarWidget => box-container {
    tree-menu #tree (orientation: horizontal) {
        +tree-menu-button #build-button (
            tool-tip: $actions-hotbar-widgets-build-tooltip,
            texture-path: "/Textures/_RF/Interface/hammer-solid.svg.192dpi.png",
            on-pressed => @OnBuildPressed
        )

        +tree-menu-button #passive-tasks-button (
            tool-tip: $actions-hotbar-widgets-passive-tasks-tooltip,
            texture-path: "/Textures/_RF/Interface/VerbIcons/hand-pointer-solid.svg.192dpi.png"
        )

        +tree-menu-button #npc-jobs-button (
            tool-tip: $actions-hotbar-widgets-npc-jobs-tooltip,
            texture-path: "/Textures/_RF/Interface/arrow-down-wide-short-solid-full.192dpi.png",
            on-pressed => @OnNpcJobsPressed
        )

        _ .low-divider (margin: 10 5)

        tree-menu-button #zoning-button (
            tool-tip: $actions-hotbar-widgets-zoning-tooltip,
            texture-path: "/Textures/_RF/Interface/vector-square-solid.svg.192dpi.png"
        )

        _ .low-divider (margin: 10 5)

        +tree-menu-button #world-map-button (
            tool-tip: $actions-hotbar-widgets-world-map-tooltip,
            texture-path: "/Textures/_RF/Interface/map-location-dot-solid.svg.192dpi.png",
            on-pressed => @OnWorldMapPressed
        )
    }
}

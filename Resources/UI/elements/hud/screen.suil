/* The screen of the game. The widgets are put in their places by the code (the anchors of the layout). */
@RimFortressScreen => layout-container (vertical-alignment: bottom, horizontal-alignment: center) {
    layout-container #viewport-container (horizontal-expand, vertical-expand) {
        main-viewport #main-viewport
    }

    /* Top left */
    box-container #top-left (orientation: vertical) {
        top-panel-widget
        +box-container #vote-menu (margin: 10 0 0 0, orientation: vertical, vertical-alignment: bottom)
    }

    /* Left */
    actions-hotbar-widget #hotbar

    /* Top right */
    box-container #top-right {
        =foldable-chat-box #chat
    }

    /* Right center */
    notifications-panel-widget #notifications

    /* Bottom */
    pop-list #pop-list (horizontal-alignment: center, vertical-alignment: bottom)

    /* Bottom right */
    =game-top-menu-bar #menu-bar (set-width: 300, margin: 10)
}

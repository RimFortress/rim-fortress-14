/* The prefix of the localization keys of the file */
let loc = lobby-character-preview-panel;

@RfLobbyCharacterPreviewPanel as lobby-character-preview-panel => col {
    _ .rim-heading .label-heading (text: $lobby-characters-preview-panel-header)
    col #loaded (visible: false) {
        row #view-box (align-self: center)
        row (align-self: center, margin: 5px 0 0 0) {
            button #character-setup .open-right (text: $<loc>-characters-setup-button)
            button #equipment-setup .open-left (text: $<loc>-equipment-setup-button)
        }
    }
    _ #unloaded (text: $<loc>-unloaded-preferences-label)
}

/* The prefix of the localization keys of the file */
let loc = ui-lobby;

@RfLobbyGui as lobby-gui => layout-container {
    /* Background */
    +texture-rect #background (
        vertical-expand,
        horizontal-expand,
        stretch: keep-aspect-covered
    )

    row #main-container (padding: 10px, gap: 2px) {
        /* LHS Controls */
        col #left-side (flex-grow: 1, gap: 4px) {
            col #default-state (flex-grow: 1, justify-content: space-between) {
                col #top-left {
                    /* Left Top Panel */
                    col .angle-rect (align-self: flex-start, max-width: 800px) {
                        link-banner #link-banner (align-self: center, margin: 3)
                        row .fancy-back (gap: 6px, padding: 3px) {
                            +ui-command-button #observe-button .font-big (
                                command: "observe",
                                text: $<loc>-observe-button
                            )
                            +_ #start-time .font-big .text-center (flex-grow: 1, color: <gray-silver>)
                            +button #ready-button .font-big (
                                text: $<loc>-ready-up-button,
                                min-width: 137px,
                                toggle-mode
                            )
                        }
                    }

                    /* Voting Popups */
                    +col #vote-container (align-self: flex-start, gap: 4px, margin: 8px 0)
                }

                /* Left Bot Panel */
                row (align-self: flex-start) {
                    dev-info-banner #dev-info-banner (margin: 3)
                    row .angle-rect (gap: 6px) {
                        +_ #lobby-song
                        +_ #lobby-background
                    }
                }
            }

            /* Character setup state */
            /* This is injected on startup. Funky! */
            +col #character-setup-state (visible: false, flex-grow: 1)

            /* Equipment editor state */
            +col #equipment-editor-state (visible: false, flex-grow: 1)
        }

        /* Right Panel */
        +col #right-side .angle-rect-transparent {
            /* Top row */
            +row #header-container .fancy-back {
                +_ #server-name .label-heading-bigger (
                    flex-grow: 1,
                    align-self: center,
                    text-align: center
                )
            }
            _ .low-divider (margin: 10px 0)
            row {
                /* Server info */
                col .panel-highlighted (flex-grow: 1, margin: 0 10px) {
                    _ .rim-heading .label-heading (text: $<loc>-server-info-block)
                    +server-info #server-info (
                        max-width: 400,
                        horizontal-alignment: left,
                        margin: 3
                    )
                    +_ #station-time (align-self: flex-start, margin: 3px, color: #D3D3D3)
                }
                _ .high-divider

                /* Voting & misc buttons */
                col .panel-highlighted (margin: 0 10px) {
                    +button #a-help-button .font-big (text: $<loc>-ahelp-button)
                    vote-call-menu-button .font-big
                    _ .flex-fill
                    +button #options-button .font-big (
                        text: $<loc>-options-button
                    )

                    +button #leave-button .font-big (
                        text: $<loc>-leave-button
                    )
                }
            }
            +lobby-character-preview-panel #character-preview (margin: 10)
            _ .low-divider (margin: 10px 0)
            +chat-box #chat (vertical-expand, margin: 3, min-height: 50)
        }
    }
}

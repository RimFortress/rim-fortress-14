@RfLayerMarkingItem => col (mouse-filter: pass, gap: 4px) {
    row (gap: 4px) {
        layered-texture #marking-texture .panel-dark-bordered (
            set-size: 64 64,
            mouse-filter: ignore,
            align-self: center
        )
        button #select-button (toggle-mode, flex-grow: 1, on-pressed => @SelectButtonPressed)
        framed-icon-button #colors-button .square (
            "/Textures/Interface/palette.svg.png",
            toggle-mode,
            visible: false,
            on-pressed => @ColorsButtonPressed,
            set-size: 36 36
        )
    }
    col #colors-container (visible: false, gap: 4px, padding: 4px 0 0 0)
}

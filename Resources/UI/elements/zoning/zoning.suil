let loc = base-zone-window;
let visuals-loc = zone-visuals;

/* The window of a zone: the name and the content of the zone, the look of the zone, and the buttons under them. */
@BaseZoneWindow => window (title: $<loc>-title, min-size: 450 550) {
    col {
        tab #tab (flex-grow: 1, on-tab-changed => @OnTabChanged) {
            scroll-container (flex-grow: 1) {
                col {
                    zone-change-name-control #name-change
                    _ .low-divider (margin: 5 3)
                    expandable-box #content-box (title: $<loc>-content-title, orientation: vertical)
                }
            }

            scroll-container (flex-grow: 1) {
                col {
                    zone-visuals-control #visuals-control (margin: 3)
                }
            }
        }

        col .angle-rect {
            zone-change-tile-control #bottom-panel (horizontal-expand, margin: 2 4)
        }
    }
}

on @Systems.Zoning.OnZoneUpdated for base-zone-window => @OnZoneUpdate
on @Systems.Zoning.OnZoneDeleted for base-zone-window => @OnZoneDelete

/* The buttons under the window of a zone: add tiles, remove tiles, delete the zone. */
@ZoneChangeTileControl => row {
    _ (flex-grow: 1)

    framed-icon-button #expand-button .square (
        "<icons>/expand-solid-full.svg.192dpi.png",
        tool-tip: $<loc>-expand-button-tooltip,
        set-size: 40,
        on-pressed => @OnExpandPressed
    )

    framed-icon-button #shrink-button .square (
        "<icons>/VerbIcons/eraser-solid.svg.192dpi.png",
        tool-tip: $<loc>-shrink-button-tooltip,
        set-size: 40,
        on-pressed => @OnShrinkPressed
    )

    confirm-button #delete-button .icon-button .square (
        confirmation-text: "",
        tool-tip: $<loc>-delete-button-tooltip,
        set-size: 40,
        on-pressed => @OnDeletePressed
    ) {
        _ .icon (background-image: texture("<icons>/ban-solid-full.svg.192dpi.png"))
    }
}

/* The name of the zone and the pencil that turns it into a field to type a new one in. */
@ZoneChangeNameControl => row (set-height: 30) {
    _ (text: $<loc>-name-label, align-self: center, margin: 0 6 0 5)

    row #name-box (align-self: center) {
        _ #name-label (align-self: center)
        icon-button #edit-button (
            "<icons>/pencil-solid.svg.192dpi.png",
            set-size: 18,
            margin: 0 5,
            on-pressed => @OnEditPressed
        )
    }

    row #name-edit-box (align-self: center, visible: false) {
        line-edit #name-edit (
            set-width: 200,
            margin: 0 5,
            on-text-entered => @SetName,
            on-focus-exit => @Cancel
        )
        icon-button #apply-name-button (
            "<icons>/check-solid.svg.192dpi.png",
            set-size: 22,
            on-pressed => @SetName
        )
        _ .low-divider (margin: 3)
        icon-button #cancel-name-button (
            "<icons>/Style/cross.png",
            set-size: 18,
            on-pressed => @Cancel
        )
    }
}

on @Systems.Zoning.OnZoneUpdated for zone-change-name-control => @OnZoneUpdate

/* The looks of the zone in its states, and the buttons to save or to drop the changes. */
@ZoneVisualsControl => col {
    col #visuals-box

    row #visual-changes-box (horizontal-expand, visible: false) {
        row .panel-dark (horizontal-expand, margin: 3 2) {
            button #save-visuals-button .open-right (
                text: $<loc>-visuals-save-button,
                margin: 2 3,
                on-pressed => {
                    #visual-changes-box.visible: false;
                    @SaveVisuals
                }
            )

            button #reset-visuals-button .open-left .red (
                text: $<loc>-visuals-reset-button,
                margin: 2 3,
                on-pressed => {
                    @ResetVisuals;
                    @UpdateVisuals
                }
            )
        }
    }
}

on @Systems.Zoning.OnZoneUpdated for zone-visuals-control => @OnZoneUpdate

/* The look of the zone in one state: the colors of the border and of the zone, the tile borders and the conditions. */
@ZoneVisualsLayerControl => col {
    expandable-box #layer-expand {
        col {
            checkbox #layer-enable-button (
                text: $<visuals-loc>-layer-enable-button,
                on-pressed => {
                    #settings-box.visible: #layer-enable-button.pressed;
                    @OnLayerToggled(#layer-enable-button.pressed)
                }
            )

            col #settings-box (margin: 3 0 3 10) {
                col .panel-dark {
                    checkbox #border-color-button (
                        text: $<visuals-loc>-border-color-button,
                        margin: 0 0 5 0,
                        on-pressed => {
                            #border-color.visible: #border-color-button.pressed;
                            @OnBorderColorToggled(#border-color-button.pressed)
                        }
                    )
                    color-selector-sliders #border-color (
                        selector-type: rgb,
                        is-alpha-visible,
                        on-color-changed => @OnBorderColorChanged
                    )
                }

                _ .low-divider (margin: 4 3)

                col .panel-dark {
                    checkbox #zone-color-button (
                        text: $<visuals-loc>-zone-color-button,
                        margin: 0 0 5 0,
                        on-pressed => {
                            #zone-color.visible: #zone-color-button.pressed;
                            @OnZoneColorToggled(#zone-color-button.pressed)
                        }
                    )
                    color-selector-sliders #zone-color (
                        selector-type: rgb,
                        is-alpha-visible,
                        on-color-changed => @OnZoneColorChanged
                    )
                }

                checkbox #show-tile-borders-button (
                    text: $<visuals-loc>-show-tile-borders-button,
                    margin: 4 3,
                    on-pressed => @OnShowTileBordersToggled(#show-tile-borders-button.pressed)
                )

                checkbox #show-conditions-button (
                    text: $<visuals-loc>-show-conditions-button,
                    margin: 4 3,
                    on-pressed => @OnShowConditionsToggled(#show-conditions-button.pressed)
                )
            }
        }
    }
}

/* What the zone has in it: the picture and "name x amount". */
@ZoneContentControl => row {
    sprite-view #sprite (set-size: 32)
    _ #label (margin: 0 5, align-self: center)
}

/* The list of the conditions of a zone, floating over the zone or over a tile. */
@ZoneConditionsList => col (min-width: 250, gap: 5px) {
    _ #label-text .outlined (text: $zone-conditions-label)
    col #conditions
}

/* One condition: the mark (met or not), the text, the pictures, the progress, and the conditions it consists of. */
@ZoneConditionControl => col {
    row {
        box #is-met-outline .condition-outline (
            set-size: 22,
            justify-content: center,
            align-items: center,
            align-self: flex-start
        ) {
            _ #is-met .condition-mark (set-size: 18)
        }

        _ #text-label .outlined (flex-grow: 1)
        row #textures (margin: 0 0 0 5, gap: 2px, align-self: center)
        _ #progress .outlined (set-width: 80, margin: 0 0 0 15)
    }

    col #sub-descriptions (margin: 0 0 0 17)
}

/* The buttons that finish or cancel the creation of a zone, next to the selection. */
@ZoneCreationWidget => box-container (margin: 15 0) {
    framed-icon-button #finish-button .square .green (
        "<icons>/check-solid.svg.192dpi.png",
        tool-tip: $zone-creation-widget-finish,
        set-size: 40,
        on-pressed => @Controllers.Zoning.OnCreationFinish
    )

    framed-icon-button #cancel-button .square .red (
        "<icons>/Style/cross.png",
        tool-tip: $zone-creation-widget-cancel,
        set-size: 40,
        margin: 0 0 0 5,
        on-pressed => @Controllers.Zoning.OnCreationCancel
    )
}

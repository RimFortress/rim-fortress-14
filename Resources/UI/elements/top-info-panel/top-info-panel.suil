/* The strip at the top of the screen: the population, the date and time, the temperature. */
@TopPanelWidget => row (
    min-width: 500,
    background-image: texture("<icons>/Style/top_info_panel.png"),
    background-repeat: stretch,
    patch-margin: 4px 8px 9px 4px,
    padding: 10px 10px 9px 10px
) {
    info-panel-cell #population (
        text: bind @PopulationText() every 1s,
        tool-tip: $top-info-panel-pops-tooltip,
        texture-path: "<icons>/VerbIcons/user-group-solid.svg.192dpi.png"
    )

    _ .low-divider
    _ .flex-fill
    _ .low-divider

    info-panel-cell #date (
        text: bind @DateText() every 1s,
        texture-path: "<icons>/calendar-solid-full.svg.192dpi.png"
    )
    info-panel-cell #time (
        text: bind @TimeText() every 1s,
        texture-path: bind if (
                @Controllers.InfoPanel.GetWorldTime().Hours >= 6
                && @Controllers.InfoPanel.GetWorldTime().Hours < 19
            ) "<icons>/sun-solid.svg.192dpi.png" else "<icons>/moon-solid.svg.192dpi.png"
            every 1s
    )
    _ .low-divider
    info-panel-cell #temperature (
        tool-tip: $top-info-panel-temperature-tooltip,
        text: bind @Controllers.InfoPanel.TempeText on @Controllers.InfoPanel.OnWorldTempChanged,
        texture-path: bind if (@Controllers.InfoPanel.WorldTempCelsius < 10) "<icons>/temperature-low-solid.svg.192dpi.png"
            elif (@Controllers.InfoPanel.WorldTempCelsius < 20) "<icons>/temperature-half-solid.svg.192dpi.png"
            elif (@Controllers.InfoPanel.WorldTempCelsius < 30) "<icons>/temperature-three-quarters-solid.svg.192dpi.png"
            else "<icons>/temperature-high-solid.svg.192dpi.png"
            on @Controllers.InfoPanel.OnWorldTempChanged
    )
}

/* A cell of the strip: an icon and a text. */
@InfoPanelCell => row (
    mouse-filter: stop,
    tracking-tooltip,
    tooltip-delay: 0,
    margin: 0 5
) {
    _ #icon (
        set-size: 24,
        background-size: contain,
        background-repeat: no-repeat,
        background-position: center,
        background-color: <rim-silver>
    )

    box (
        margin: 0 0 0 5,
        background-color: <graphite-black>,
        border-bottom: 1px solid <black-amber>
    ) {
        _ #label
    }
}

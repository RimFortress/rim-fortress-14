/* The strip at the top of the screen: the population, the date and time, the temperature. */
@TopPanelWidget => row (
    min-width: 500,
    background-image: texture("<icons>/Style/top_info_panel.png"),
    background-repeat: stretch,
    patch-margin: 4px 8px 9px 4px,
    padding: 10px 10px 9px 10px
) {
    info-panel-cell #population (
        tool-tip: $top-info-panel-pops-tooltip,
        texture-path: "<icons>/VerbIcons/user-group-solid.svg.192dpi.png"
    )

    _ .low-divider
    _ .flex-fill
    _ .low-divider

    info-panel-cell #date (texture-path: "<icons>/calendar-solid-full.svg.192dpi.png")
    info-panel-cell #time (texture-path: "<icons>/sun-solid.svg.192dpi.png")

    _ .low-divider

    info-panel-cell #temperature (
        tool-tip: $top-info-panel-temperature-tooltip,
        texture-path: "<icons>/temperature-half-solid.svg.192dpi.png"
    )
}

/* A cell of the strip: an icon and a text. */
@InfoPanelCell => row (mouse-filter: stop, tracking-tooltip, tooltip-delay: 0, margin: 0 5) {
    _ #icon (
        set-size: 24,
        background-size: contain,
        background-repeat: no-repeat,
        background-position: center,
        background-color: <rim-silver>
    )

    box (margin: 0 0 0 5, background-color: <graphite-black>, border-bottom: 1px solid <black-amber>) {
        _ #label
    }
}

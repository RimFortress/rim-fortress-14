// The view of SuilHotReloadViewTest: a real view built by the generator, to see that the hot reload builds the
// same tree as the generated code and that the subscriptions made in the code stay.
@GeneratedHotReloadView => box .hot-reload-root #hot-reload-root (
    min-width: 40
) {
    +button #hot-submit .primary (
        text: "Go",
        disabled
    )

    +box #hot-nested .nested {
        button .plain (text: "Plain")
    }
}

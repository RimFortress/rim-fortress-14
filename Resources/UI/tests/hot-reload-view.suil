// The view of SuilHotReloadViewTest: a real view built by the generator, to see that the hot reload builds the
// same tree as the generated code and that its handlers replace the compiled ones.
@GeneratedHotReloadView => box .hot-reload-root #hot-reload-root (min-width: 40) {
    +button #hot-submit .primary (text: "Go", disabled, on-pressed => {
        @OnHotSubmit;
        &(add .pressed);
        #hot-nested (min-height: calc(&.min-width + 3px), visible: !&.disabled, min-width +: 4)
    })
    +box #hot-nested .nested {
        button .plain (text: "Plain")
    }
}

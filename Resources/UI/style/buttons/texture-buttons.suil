/* ---------- Texture buttons ---------- */

/* HelpButton */
.help-button {
    background-image: texture("/Textures/Interface/VerbIcons/information.svg.192dpi.png");
    background-repeat: no-repeat;
}

/* CrossButtonRed */
.cross-button-red {
    background-image: texture("<icons>/Style/cross.png");
    background-repeat: stretch;
    border-style: none;
    border-width: 0;
    border-image: none;
    padding: 0;
    background-color: <bad>;
}

.cross-button-red:hover {
    background-color: <light-bad>;
}

.cross-button-red:active,
.cross-button-red:checked {
    background-color: <darkest-bad>;
}

/* ---------- Slots and hotbar ---------- */

/* InventorySlotBackground */
.inventory-slot-background {
    background-image: texture("/Textures/Interface/Inventory/inv_slot_background.png");
    background-repeat: stretch;
    patch-margin: 2px;
    padding: 0;
}

/* HandSlotHighlight */
.hand-slot-highlight {
    background-image: texture("/Textures/Interface/Inventory/hand_slot_highlight.png");
    background-repeat: stretch;
    patch-margin: 2px;
    padding: 2px;
}

/* HotbarPanel: the transparent bordered window background expanded by 4 */
.hotbar-panel {
    background-image: texture("<icons>/Style/transparent_window_background_bordered.png");
    background-repeat: stretch;
    patch-margin: 2px;
    expand-patch-margin: 4px;
    padding: 2px;
}

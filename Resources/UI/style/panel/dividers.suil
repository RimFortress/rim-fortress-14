/* ---------- Dividers ---------- */

/* StyleClass.LowDivider: LowDivider */
.low-divider {
    background-color: <gold-fortress>;
    min-width: 2px;
    min-height: 2px;
}

/* StyleClass.HighDivider: HighDivider */
.high-divider {
    background-color: <gold-fortress>;
    min-width: 3px;
    min-height: 3px;
}

/* LowDividerDark */
.low-divider-dark {
    background-color: <black-amber>;
    min-width: 2px;
    min-height: 2px;
}

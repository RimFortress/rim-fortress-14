/* ---------- Paper ---------- */

/* PaperWrittenText */
.paper-written-text {
    font-size: 12px;
    color: <black-amber>;
}

/* ---------- Window / PDA text ---------- */

/* PdaContentFooterText */
.pda-content-footer-text {
    font-size: 10px;
    color: <pda-footer-text>;
}

/* PdaWindowFooterText */
.pda-window-footer-text {
    font-size: 10px;
    color: <pda-window-footer-text>;
}

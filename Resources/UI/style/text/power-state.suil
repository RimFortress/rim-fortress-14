/* ---------- APC and SMES power state ---------- */

/* PowerStateNone: rgb(0.8, 0, 0) */
.power-state-none {
    color: rgb(204, 0, 0);
}

/* PowerStateLow: rgb(0.9, 0.36, 0) */
.power-state-low {
    color: rgb(230, 92, 0);
}

/* PowerStateGood: rgb(0.024, 0.8, 0) */
.power-state-good {
    color: rgb(6, 204, 0);
}

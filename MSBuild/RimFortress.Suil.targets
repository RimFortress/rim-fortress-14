<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="12.0">
  <!--
  SUIL (Styled UI Layout): the source generator of the views and the files it reads.
  The .suil files live in Resources/UI/, and the paths in `use` are relative to that folder:
  Resources/UI/Lobby/Screen.suil is written as /Lobby/Screen (the extension is optional).
  A view is a declaration `@Class => element` in any of the files; Resources/UI/tests/ holds the views of the tests,
  which only the test project builds.
  -->
  <PropertyGroup>
    <!-- The tables of the game include the controls of the engine and of the referenced assemblies. -->
    <SuilIncludeReferencedControls>true</SuilIncludeReferencedControls>
    <SuilRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'Resources', 'UI'))</SuilRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- The generator reads them as additional files; an edit of one of them regenerates the views. -->
    <AdditionalFiles Include="$(SuilRoot)**/*.suil" Exclude="$(SuilRoot)tests/**" />
    <CompilerVisibleProperty Include="SuilRoot" />
    <CompilerVisibleProperty Include="SuilIncludeReferencedControls" />
  </ItemGroup>

  <ItemGroup>
    <!--
    The language itself (the tokenizer, the parser, the expander) is compiled into the project, not referenced as an
    assembly: the game package lists its assemblies by name, and one assembly is checked by the sandbox as it is.
    -->
    <Compile Include="$(MSBuildThisFileDirectory)..\Content.Suil\**\*.cs" Exclude="$(MSBuildThisFileDirectory)..\Content.Suil\obj\**;$(MSBuildThisFileDirectory)..\Content.Suil\bin\**">
      <Link>_RF/Suil/Language/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)\..\Content.Suil.Generator\Content.Suil.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>
</Project>
